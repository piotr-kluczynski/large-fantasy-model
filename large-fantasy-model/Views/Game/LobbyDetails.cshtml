@model large_fantasy_model.ViewModels.GameLobbyViewModel

@{
    ViewData["Title"] = Model.Name + " - Lobby";
}

<div class="container mt-4">
    
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <h1 class="fw-bold text-primary mb-0">@Model.Name</h1>
            
            
            <div>
                @if (Model.IsPublic)
                {
                    @if (Model.IsPublic)
                    {
                        <span class="badge bg-white text-success border border-success rounded-pill px-3 py-2 align-middle">Public Campaign</span>
                    }
                }
                else
                {
                    <span class="badge bg-white text-danger border border-danger rounded-pill px-3 py-2 align-middle">Private Campaign</span>
                }
            </div>
        </div>
        <div>
            
            <button class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm px-5">
             Enter Virtual Tabletop
            </button>
        </div>
    </div>

    <div class="row">
        
        <div class="col-lg-8 mb-4">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h4 class="fw-bold">Campaign Description</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted fs-5" style="white-space: pre-line;">@Model.Description</p>
                </div>
            </div>

            
            @if (Model.IsDungeonMaster)
            {
                <div class="card border-primary border-2 shadow-sm rounded-4 bg-light mb-4">
                    <div class="card-body text-center p-4">
                        <h5 class="fw-bold text-primary mb-3">Invite Code</h5>
                        <p class="text-muted small mb-3">Share this code with players so they can join your adventure.</p>
                        <div class="d-inline-block bg-white border border-primary border-2 rounded-3 px-5 py-2">
                            <span class="fs-1 fw-bold font-monospace tracking-widest text-dark">@Model.JoinCode</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        
        <div class="col-lg-4 mb-4">
            
            
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-primary text-white border-0 pt-3 pb-2 rounded-top-4">
                    <h5 class="fw-bold mb-0">Adventuring Party</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush rounded-bottom-4">
                        
                        <li class="list-group-item d-flex align-items-center py-3 bg-light">
                            <img src="https://ui-avatars.com/api/?name=@Model.DungeonMaster.Username&size=40&background=random" class="rounded-circle me-3 border border-danger border-2" alt="Avatar" />
                            <div>
                                <span class="fw-bold d-block">@Model.DungeonMaster.Username</span>
                                <small class="text-danger fw-bold"> Dungeon Master</small>
                            </div>
                        </li>

                        @if (!Model.Players.Any())
                        {
                            <li class="list-group-item text-center py-4 text-muted small italic">
                                No travelers have joined yet.
                            </li>
                        }
                        else
                        {
                            @foreach (var player in Model.Players)
                            {
                                <li class="list-group-item p-3 border-top d-flex align-items-center justify-content-between border-0">
                                    <div class="d-flex align-items-center">
                                        
                                        <div class="avatar-circle me-3 border border-success border-2 " style="background-color: #e83e8c;">
                                            <span class="text-white fw-bold">@player.Username.Substring(0, 2).ToUpper()</span>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@player.Username</div>
                                            <small class="text-success fw-bold">Player</small>
                                        </div>
                                    </div>

                                    
                                    @if (Model.IsDungeonMaster)
                                    {
                                        <form asp-action="RemovePlayer" method="post" onsubmit="return confirm('Kick this player from the campaign?');">
                                            <input type="hidden" name="gameId" value="@Model.GameId" />
                                            <input type="hidden" name="playerId" value="@player.Id" />
                                            <button type="submit" class="btn btn-sm border-0 bg-transparent shadow-none p-0 ms-2 btn-kick">
                                                <i class="bi bi-x" style="font-size: 2rem; line-height: 1;"></i>
                                            </button>
                                        </form>
                                    }
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>

            
            @if (Model.AvailableFriends.Any())
            {
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold text-dark">Invite Friends</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var friend in Model.AvailableFriends)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div class="d-flex align-items-center">
                                        <img src="https://ui-avatars.com/api/?name=@friend.Username&size=32&background=random" class="rounded-circle me-2" alt="Avatar" />
                                        <span class="fw-semibold">@friend.Username</span>
                                    </div>
                                    <form asp-action="InviteFriend" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="gameId" value="@Model.GameId" />
                                        <input type="hidden" name="friendId" value="@friend.Id" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">Invite</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<style>
    

   <style>
    .btn-kick {
        background: none;
        border: none;
        padding: 0;
        color: #000; 
        transition: color 0.2s ease-in-out, transform 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        outline: none !important;
        box-shadow: none !important;
    }

    .btn-kick i {
        font-size: 2rem; 
        line-height: 1;
    }

    .btn-kick:hover {
        color: #dc3545; 
        
    }
    .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .avatar-circle span {
    line-height: 1;
    display: block;
</style>