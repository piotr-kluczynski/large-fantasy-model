@model large_fantasy_model.ViewModels.CreateGameViewModel

@{
    ViewData["Title"] = "Edit Campaign";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 position-relative">
                    <i class="bi bi-gear-fill position-absolute" style="font-size: 15rem; right: -30px; top: -30px; opacity: 0.02; color: var(--blame-main);"></i>
                    
                    <div class="text-center mb-5 position-relative" style="z-index: 2;">
                        <div class="feature-icon-small d-inline-flex align-items-center justify-content-center text-white rounded-circle shadow-sm mb-3" style="width: 70px; height: 70px; background: var(--blame-gradient);">
                            <i class="bi bi-gear-fill fs-2"></i>
                        </div>
                        <h2 class="fw-bold mb-1" style="color: var(--blame-side-dark);">Edit Campaign Settings</h2>
                        <p class="text-muted">Update your world rules and requirements.</p>
                    </div>

                    <form asp-action="Edit" method="post" class="position-relative" style="z-index: 2;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@ViewBag.GameId" />

                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control rounded-4 shadow-sm border-light" placeholder="Campaign Name" style="background-color: #fcfcfc;" />
                            <label asp-for="Name" class="fw-bold text-muted"><i class="bi bi-pencil-fill me-2" style="color: var(--blame-main);"></i>Campaign Name</label>
                            <span asp-validation-for="Name" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Description" class="form-control rounded-4 shadow-sm border-light custom-scrollbar" style="height: 150px; background-color: #fcfcfc;" placeholder="Description"></textarea>
                            <label asp-for="Description" class="fw-bold text-muted"><i class="bi bi-text-paragraph me-2" style="color: var(--blame-main);"></i>Description</label>
                            <span asp-validation-for="Description" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="MaxPlayers" type="number" class="form-control rounded-4 shadow-sm border-light" min="2" max="50" placeholder="Max Players" style="background-color: #fcfcfc;" />
                            <label asp-for="MaxPlayers" class="fw-bold text-muted"><i class="bi bi-people-fill me-2" style="color: var(--blame-main);"></i>Max Players</label>
                            <span asp-validation-for="MaxPlayers" class="text-danger small"></span>
                        </div>

                        <div class="card border-light shadow-sm rounded-4 mb-4" style="background-color: #fcfcfc;">
                            <div class="card-body d-flex align-items-center justify-content-between p-3 px-4">
                                <div>
                                    <h6 class="fw-bold mb-1" style="color: var(--blame-side-dark);"><i class="bi bi-globe me-2" style="color: var(--blame-main);"></i>Public Lobby</h6>
                                    <small class="text-muted">Visible in the 'Find Game' board.</small>
                                </div>
                                <div class="form-check form-switch fs-3 mb-0">
                                    <input asp-for="IsPublic" class="form-check-input" type="checkbox" role="switch" id="isPublicSwitch" style="cursor: pointer;">
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4 @(Model.IsPublic ? "d-none" : "")" id="passwordField">
                            <input asp-for="Password" type="password" class="form-control rounded-4 shadow-sm border-light" placeholder="Lobby Password" style="background-color: #fcfcfc;" />
                            <label asp-for="Password" class="fw-bold text-muted"><i class="bi bi-lock-fill me-2" style="color: var(--blame-main);"></i>Lobby Password</label>
                            <span asp-validation-for="Password" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-gradient btn-lg rounded-pill fw-bold shadow-sm py-3">Save Changes</button>
                            <a asp-action="LobbyDetails" asp-route-id="@ViewBag.GameId" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold shadow-sm py-3">Cancel</a>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Game/Edit.js"></script>
}