@model IEnumerable<large_fantasy_model.Models.Game>

@{
    ViewData["Title"] = "My Campaigns";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">My Campaigns</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill fw-bold px-4 shadow-sm">Create New Campaign</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["DangerMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Deleted.</strong> @TempData["DangerMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center py-5">
            <div class="card-body py-5">
                <h4 class="text-muted mb-3 fw-bold">You don't have any active campaigns.</h4>
                <p class="text-secondary mb-4">Start your journey as a Game Master or join an existing game!</p>
                <a asp-action="Create" class="btn btn-outline-primary btn-lg rounded-pill fw-bold px-5">Start a New Journey</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var game in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-header bg-dark text-white border-0 pt-3 pb-2 rounded-top-4">
                            <h5 class="fw-bold mb-0 text-truncate" title="@game.Name">@game.Name</h5>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="card-text text-muted mb-4 flex-grow-1">
                                @(game.Description.Length > 120 ? game.Description.Substring(0, 120) + "..." : game.Description)
                            </p>
                            
                            <hr class="text-muted opacity-25">
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <small class="text-secondary fw-semibold">
                                    Created: @game.CreationDate.ToString("MM/dd/yyyy")
                                </small>
                                
                                
                                <div class="d-flex gap-2">
                                    
                                    
                                    @if (game.UserId == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value))
                                    {
                                        <form asp-action="Delete" asp-route-id="@game.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this campaign? This action cannot be undone.');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 shadow-sm">Delete</button>
                                        </form>
                                    }

                                    <button class="btn btn-primary btn-sm rounded-pill fw-bold px-3 shadow-sm">Enter Lobby</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            
        </div>
    }
</div>