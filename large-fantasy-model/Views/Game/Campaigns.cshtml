@model IEnumerable<large_fantasy_model.Models.Game>

@{
    ViewData["Title"] = "My Campaigns";
}

<div class="container mt-4">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 bg-white p-4 p-md-5 rounded-4 shadow-sm border-0 position-relative overflow-hidden">
        <!-- Decorative background element -->
        <i class="bi bi-compass position-absolute" style="font-size: 15rem; right: 10%; top: -50px; opacity: 0.02; color: var(--blame-main); transform: rotate(15deg);"></i>
        
        <div class="position-relative z-2 mb-4 mb-md-0">
            <h1 class="display-5 fw-bold mb-2" style="color: var(--blame-side-dark); letter-spacing: -1px;">
                <i class="bi bi-journal-album me-2" style="color: var(--blame-main);"></i>
                My Campaigns
            </h1>
            <p class="text-secondary fs-5 mb-0" style="max-width: 500px;">
                Manage your epic adventures, track your heroes, and forge new legends in your worlds.
            </p>
        </div>
        <div class="position-relative z-2">
            <a asp-action="Create" class="btn btn-gradient rounded-pill fw-bold px-5 py-3 shadow-sm d-inline-flex align-items-center">
                <i class="bi bi-plus-circle-fill fs-5 me-2"></i> Create New Campaign
            </a>
        </div>
    </div>

   
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["DangerMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Error</strong> @TempData["DangerMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 border-top border-secondary border-4 rounded-4 text-center py-5 transition-hover">
            <div class="card-body py-5">
                <div class="display-1 text-muted mb-3"><i class="bi bi-journal-x"></i></div>
                <h4 class="text-muted mb-3 fw-bold">You don't have any active campaigns.</h4>
                <p class="text-secondary mb-0">Start your journey as a Game Master or join an existing game!</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var game in Model)
            {
                <div class="col-md-4">
                   
                    <div class="card h-100 shadow-sm border-0 rounded-4 transition-hover overflow-hidden" style="background-color: #ffffff;">
                        <div class="card-body p-0 position-relative d-flex flex-column">
                            <!-- Watermark -->
                            <i class="bi bi-shield-shaded position-absolute" style="font-size: 8rem; right: -15px; bottom: 80px; opacity: 0.03; color: var(--blame-main);"></i>
                            
                            <div class="p-4 pb-2 d-flex flex-column flex-grow-1">
                                <!-- Top Row: Icon + Badge -->
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="feature-icon-small d-inline-flex align-items-center justify-content-center text-white rounded-4 shadow-sm" style="width: 56px; height: 56px; background: var(--blame-gradient); flex-shrink: 0;">
                                        <i class="bi bi-shield-shaded fs-4"></i>
                                    </div>
                                    <div>
                                        @if (game.IsActive)
                                        {
                                            <span class="badge rounded-pill px-3 py-2 border shadow-sm" style="color: var(--blame-main); background: rgba(174, 26, 103, 0.05); border-color: var(--blame-main) !important; letter-spacing: 0.5px;">
                                                <i class="bi bi-activity me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2 bg-light text-secondary border shadow-sm" style="letter-spacing: 0.5px;">
                                                <i class="bi bi-pause-circle me-1"></i> Inactive
                                            </span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Title -->
                                <h4 class="card-title fw-bold mb-2 text-truncate" style="color: var(--blame-side-dark);" title="@game.Name">@game.Name</h4>
                                
                                <!-- Date Info -->
                                <div class="d-flex align-items-center text-muted small mb-3 fw-semibold">
                                    <i class="bi bi-calendar3 me-2 opacity-75" style="color: var(--blame-main);"></i> 
                                    Est. @game.CreationDate.ToString("MMMM dd, yyyy")
                                </div>
                                
                                <!-- Divider -->
                                <hr class="opacity-10 my-2" style="border-top: 2px dashed #eaeaea;">
                                
                                <!-- Description -->
                                <p class="card-text text-secondary mt-3 mb-0 flex-grow-1" style="font-size: 0.95rem; line-height: 1.6;">
                                    @(game.Description.Length > 100 ? game.Description.Substring(0, 100) + "..." : game.Description)
                                </p>
                            </div>

                            <!-- Footer Actions -->
                            <div class="p-4 pt-0 mt-auto position-relative" style="z-index: 2;">
                                <div class="d-flex flex-column gap-2 mt-3">
                                    <a asp-action="LobbyDetails" asp-route-id="@game.Id" class="btn btn-gradient w-100 rounded-pill fw-bold stretched-link shadow-sm py-2">
                                        Enter Lobby <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    
                                    @if (game.UserId == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value))
                                    {
                                        <form asp-action="Delete" asp-route-id="@game.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this campaign? This action cannot be undone.');" class="position-relative z-3">
                                            <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold py-2">
                                                Delete Campaign
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="LeaveCampaign" asp-route-gameId="@game.Id" method="post" onsubmit="return confirm('Are you sure you want to leave this campaign?');" class="position-relative z-3">
                                            <button type="submit" class="btn btn-outline-secondary w-100 rounded-pill fw-bold py-2">
                                                Leave Campaign
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
@section Styles {
    <style>
    
        .transition-hover {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }
    </style>
}