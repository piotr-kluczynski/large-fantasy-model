@{
@using System.Security.Claims
@using large_fantasy_model.Data
    @inject LargeFantasyModelContext _context

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string GetActiveMenuClass(string controller, string action, string activeTextColor = "text-primary")
    {
        return (currentController == controller && currentAction == action)
            ? $"{activeTextColor} fw-bold active-link"
            : "text-dark";
    }

    string GetUserColor(string username)
    {
        if (string.IsNullOrEmpty(username)) return "0d6efd";
        var colors = new[] { "0d6efd", "198754", "dc3545", "fd7e14", "e83e8c", "6f42c1", "20c997", "0dcaf0" };
        int hash = 0;
        foreach (char c in username) { hash += c; }
        return colors[hash % colors.Length];
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - large_fantasy_model</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/large_fantasy_model.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        @{
            int unreadMessagesCount = 0;
            int friendRequestsCount = 0;

            if (User.Identity?.IsAuthenticated == true)
            {
                var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
                if (int.TryParse(userIdString, out int myId))
                {
                    unreadMessagesCount = _context.Messages
                        .Count(m => !m.IsRead && m.UserId != myId && m.Conversation.Game == null && m.Conversation.Users.Any(u => u.Id == myId));
                    friendRequestsCount = _context.Notifications
                        .Count(n => n.ReceiverId == myId && !n.IsRead && n.Type == "FriendRequest");
                }
            }
        }
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm py-3 mb-3">
            <div class="container-fluid px-md-5">
                <a class="navbar-brand fw-bold fs-3 text-primary fantasy-font" asp-area="" asp-controller="Home" asp-action="Index">
                    LFM <span class="text-dark">Online</span>
                </a>
        
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between ms-4">
                    <ul class="navbar-nav flex-grow-1 fs-5">
                        <li class="nav-item me-3">
                            <a class="nav-link @GetActiveMenuClass("Home", "Index") px-2" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @GetActiveMenuClass("Admin", "Users") px-2" asp-controller="Admin" asp-action="Users">Admin Panel</a>
                            </li>
                        }
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link @GetActiveMenuClass("FindGame", "Find") px-2" asp-controller="FindGame" asp-action="Find">Find Lobby</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link nav-link-success @GetActiveMenuClass("Game", "Campaigns", "text-success") px-2" asp-controller="Game" asp-action="Campaigns">My Campaigns</a>
                            </li>
                        }
                        <li class="nav-item me-3">
                            <a class="nav-link nav-link-danger @GetActiveMenuClass("Compendium", "Index", "text-danger") px-2" asp-controller="Compendium" asp-action="Index">Compendium</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div id="notification-bell-container" style="display: contents;">
                                @await Component.InvokeAsync("NotificationBell")
                            </div>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold border rounded-pill px-4 py-2 bg-light shadow-sm"
                                       href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-display="static">
                                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&size=32&background=@GetUserColor(User.Identity.Name)&color=fff&length=2"
                                         class="rounded-circle me-2" alt="Avatar" />
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 rounded-4 p-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2" asp-controller="Profile" asp-action="ProfilePage">
                                            <div class="d-flex justify-content-center flex-shrink-0 me-3" style="width: 30px;">
                                                <i class="bi bi-person-circle text-dark fs-5 mt-1"></i>
                                            </div>
                                            <span class="fw-semibold">My Profile</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center justify-content-between py-2" asp-controller="Profile" asp-action="Friends">
                                            <div class="d-flex align-items-center">
                                                <div class="d-flex justify-content-center flex-shrink-0 me-3" style="width: 30px;">
                                                    <i class="bi bi-people text-dark fs-5 mt-1"></i>
                                                </div>
                                                <span class="fw-semibold">Friends List</span>
                                            </div>
                                            <span id="friend-requests-badge" class="badge bg-danger rounded-pill shadow-sm" style="display: @(friendRequestsCount > 0 ? "inline-block" : "none");">
                                                @friendRequestsCount
                                            </span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center justify-content-between py-2" asp-controller="PrivateMessage" asp-action="PrivateMessage">
                                            <div class="d-flex align-items-center">
                                                <div class="d-flex justify-content-center flex-shrink-0 me-3" style="width: 30px;">
                                                    <i class="bi bi-chat-dots text-dark fs-5 mt-1"></i>
                                                </div>
                                                <span class="fw-semibold">Messages</span>
                                            </div>
                                            <span id="unread-messages-badge" class="badge bg-danger rounded-pill shadow-sm" style="display: @(unreadMessagesCount > 0 ? "inline-block" : "none");">
                                                @unreadMessagesCount
                                            </span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2" asp-controller="Profile" asp-action="Edit">
                                            <div class="d-flex justify-content-center flex-shrink-0 me-3" style="width: 30px;">
                                                <i class="bi bi-gear text-dark fs-5 mt-1"></i>
                                            </div>
                                            <span class="fw-semibold">Settings</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-2 opacity-25"></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-2 logout-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <div class="d-flex justify-content-center flex-shrink-0 me-3" style="width: 30px;">
                                                <i class="bi bi-box-arrow-right fs-5 mt-1"></i>
                                            </div>
                                            <span class="fw-bold">Logout</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold me-3" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-primary text-white px-4 py-2 rounded-pill shadow-sm fw-bold"
                                   asp-controller="Auth" asp-action="Register">Join Adventure</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        @if (User.HasClaim("IsImpersonating", "true"))
        {
            <div class="bg-danger text-white text-center py-1">
                <strong>Impersonation Mode:</strong> You are logged in as: @User.Identity.Name.
                <form asp-controller="Admin" asp-action="RevertImpersonation" method="post" class="d-inline ms-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link text-white fw-bold p-0" style="text-decoration: underline; border: none; vertical-align: baseline;">
                        Return to Admin account
                    </button>
                </form>
            </div>
        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - large_fantasy_model - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        
        <script>
            window.globalUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
        </script>
        
        <script src="~/js/NotificationBell.js" asp-append-version="true"></script>
    }
   
    
    </body>
</html>