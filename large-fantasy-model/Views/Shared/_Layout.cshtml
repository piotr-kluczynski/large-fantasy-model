@{
    
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

  
    string GetActiveMenuClass(string controller, string action)
    {
        return (currentController == controller && currentAction == action)
            ? "text-primary fw-bold active-link"
            : "text-dark";
    }
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - large_fantasy_model</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/large_fantasy_model.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm py-3 mb-3">
            <div class="container-fluid px-md-5">
                <a class="navbar-brand fw-bold fs-3 text-primary fantasy-font" asp-area="" asp-controller="Home" asp-action="Index">
                    LFM <span class="text-dark">Online</span>
                </a>
        
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between ms-4">
                    <ul class="navbar-nav flex-grow-1 fs-5">
                        <li class="nav-item me-3">
                            <a class="nav-link @GetActiveMenuClass("Home", "Index") px-2" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
    
                        @if (User.Identity.IsAuthenticated)
                        {
                           
                            <li class="nav-item me-3">
                                <a class="nav-link @GetActiveMenuClass("Game", "Campaigns") px-2" asp-controller="Game" asp-action="Campaigns">
                                Campaigns
                                </a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link @GetActiveMenuClass("FindGame", "Find") px-2" asp-controller="FindGame" asp-action="Find">
                                Find Game
                                </a>
                            </li>
                        }

                        <li class="nav-item me-3">
                            <a class="nav-link @GetActiveMenuClass("Compendium", "Index") px-2"
                               asp-controller="Compendium"
                               asp-action="Index">Compendium</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @GetActiveMenuClass("Admin", "Users") px-2" asp-controller="Admin" asp-action="Users">Admin Panel</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold border rounded-pill px-4 py-2 bg-light shadow-sm"
                                       href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                       data-bs-display="static">
        
                                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&size=32&background=random"
                                         class="rounded-circle me-2" alt="Avatar" />
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 rounded-4 p-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 mb-1 fw-semibold d-flex align-items-center" asp-controller="Profile" asp-action="ProfilePage">
                                            <span class="me-3 fs-5"></span> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 mb-1 fw-semibold d-flex align-items-center" asp-controller="Profile" asp-action="Friends">
                                            <span class="me-3 fs-5"></span> Friends List
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 mb-1 fw-semibold d-flex align-items-center" asp-controller="PrivateMessage" asp-action="Index">
                                            <span class="me-3 fs-5"></span> Messages
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 mb-1 fw-semibold d-flex align-items-center" asp-controller="Profile" asp-action="Edit">
                                            <span class="me-3 fs-5"></span> Edit Details
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-2 opacity-25"></li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 fw-bold text-danger d-flex align-items-center logout-item" asp-controller="Auth" asp-action="Logout">
                                            <span class="me-3 fs-5"></span> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold me-3" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-primary text-white px-4 py-2 rounded-pill shadow-sm fw-bold"
                                   asp-controller="Auth" asp-action="Register">Join Adventure</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        @if (User.HasClaim("IsImpersonating", "true"))
        {
            <div class="bg-danger text-white text-center py-1">
                <strong>Tryb Podszywania:</strong> Jesteś zalogowany jako @User.Identity.Name.
                <form asp-controller="Admin" asp-action="RevertImpersonation" method="post" class="d-inline ms-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link text-white fw-bold p-0" style="text-decoration: underline; border: none; vertical-align: baseline;">
                        Wróć do konta Admina
                    </button>
                </form>
            </div>
        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - large_fantasy_model - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
