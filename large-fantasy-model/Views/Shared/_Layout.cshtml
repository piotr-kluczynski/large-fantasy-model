@{
    @using System.Security.Claims
    @using large_fantasy_model.Data
    @using Microsoft.AspNetCore.Hosting
    @inject LargeFantasyModelContext _context
    @inject IWebHostEnvironment _env

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string GetActiveMenuClass(string controller, string action)
    {
        return (currentController == controller && currentAction == action)
            ? "active-link"
            : "";
    }

    string GetActiveControllerClass(string controller)
    {
        return (currentController == controller)
            ? "active-link"
            : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(ViewData["Title"]?.ToString()) ? "Large Fantasy Model" : ViewData["Title"] + " - Large Fantasy Model")</title>
    <link rel="icon" type="image/png" href="~/GraphicElements/LogoSquare.png?v=3" />
    <link rel="shortcut icon" href="~/GraphicElements/LogoSquare.png?v=3" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/large_fantasy_model.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-global-user-id="@(User.Identity?.IsAuthenticated == true ? User.FindFirstValue(ClaimTypes.NameIdentifier) : "")">
    @{
        int unreadMessagesCount = 0;
        int friendRequestsCount = 0;

        if (User.Identity?.IsAuthenticated == true)
        {
            var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (int.TryParse(userIdString, out int myId))
            {
                unreadMessagesCount = _context.Messages
                    .Count(m => !m.IsRead && m.UserId != myId && m.Conversation.Game == null && m.Conversation.Users.Any(u => u.Id == myId));
                friendRequestsCount = _context.Notifications
                    .Count(n => n.ReceiverId == myId && !n.IsRead && n.Type == "FriendRequest");
            }
        }
    }

    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-header pt-4 pb-3 m-0 overflow-hidden text-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="d-inline-block text-center m-0 p-0" style="width: 100%;">
                    <img src="~/GraphicElements/LogoCropped.png" alt="Large Fantasy Model Logo" style="width: 20%; max-width: 160px; height: auto;" />
                </a>
            </div>
            
            <div class="sidebar-nav">
                <div class="nav-section">Menu</div> 
                <a class="sidebar-link @GetActiveControllerClass("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Home
                </a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="sidebar-link @GetActiveControllerClass("Game")" asp-controller="Game" asp-action="Campaigns">
                        <i class="bi bi-journal-bookmark"></i> Campaigns
                    </a>
                    <a class="sidebar-link @GetActiveControllerClass("FindGame")" asp-controller="FindGame" asp-action="Find">
                        <i class="bi bi-search"></i> Find Lobby
                    </a>
                }
                <a class="sidebar-link @GetActiveControllerClass("Compendium")" asp-controller="Compendium" asp-action="Index">
                    <i class="bi bi-book"></i> Compendium
                </a>
                <a class="sidebar-link @GetActiveControllerClass("Character")" asp-controller="Character" asp-action="Index">
                    <i class="bi bi-person-vcard"></i> Character
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="nav-section">Social</div>
                    <a class="sidebar-link @GetActiveControllerClass("Profile")" asp-controller="Profile" asp-action="Friends">
                        <i class="bi bi-people"></i> Friends
                        <span id="friend-requests-badge" class="badge bg-danger ms-auto rounded-pill" style="@(friendRequestsCount > 0 ? "" : "display: none;")">@friendRequestsCount</span>
                    </a>
                    <a class="sidebar-link @GetActiveControllerClass("PrivateMessage")" asp-controller="PrivateMessage" asp-action="PrivateMessage">
                        <i class="bi bi-chat-dots"></i> Messages
                        <span id="unread-messages-badge" class="badge bg-danger ms-auto rounded-pill" style="@(unreadMessagesCount > 0 ? "" : "display: none;")">@unreadMessagesCount</span>
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-section">Admin</div>
                    <a class="sidebar-link @GetActiveControllerClass("Admin")" asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-shield-lock"></i> Admin Panel
                    </a>
                }
            </div>

            <div class="sidebar-footer p-3 border-top mt-auto">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="mb-3" id="notification-bell-container">
                        @await Component.InvokeAsync("NotificationBell")
                    </div>
                    
                    <div class="d-flex align-items-center justify-content-between p-2 shadow-sm" style="border-radius: 16px; background-color: #fff; border: 1px solid #eaeaea; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'">
                        <a class="sidebar-profile d-flex align-items-center text-decoration-none flex-grow-1" asp-controller="Profile" asp-action="ProfilePage" style="padding-right: 10px;">
                            <img src="@AvatarHelper.GetUserAvatar(User.Identity?.Name ?? "", User.FindFirst("ProfilePicturePath")?.Value, _env.WebRootPath, 50)" alt="Avatar" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid var(--blame-side-light);" />
                            <div class="sidebar-profile-info ms-2">
                                <span class="sidebar-profile-name fw-bold" style="color: var(--blame-side-dark); font-size: 1rem;">@User.Identity.Name</span>
                                <span class="sidebar-profile-role text-muted" style="font-size: 0.8rem;">Traveler</span>
                            </div>
                        </a>
                        <a asp-controller="Auth" asp-action="Logout" class="text-danger d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px; transition: all 0.2s; background-color: transparent;" onmouseover="this.style.backgroundColor='#ffe6e6'; this.style.transform='scale(1.1)';" onmouseout="this.style.backgroundColor='transparent'; this.style.transform='none';" title="Logout">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </a>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-dark w-100 mb-2 fw-bold" asp-controller="Auth" asp-action="Login">Login</a>
                    <a class="btn btn-primary w-100 fw-bold" asp-controller="Auth" asp-action="Register">Join Adventure</a>
                }
            </div>
        </aside>

        <main role="main" class="main-content d-flex flex-column">
            @if (User.HasClaim("IsImpersonating", "true"))
            {
                <div class="bg-danger text-white text-center py-2 fw-bold">
                    <strong>Impersonation Mode:</strong> You are logged in as: @User.Identity.Name.
                    <form asp-controller="Admin" asp-action="RevertImpersonation" method="post" class="d-inline ms-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-white fw-bold p-0" style="text-decoration: underline; border: none; vertical-align: baseline;">
                            Return to Admin account
                        </button>
                    </form>
                </div>
            }

            <div class="container-fluid p-4 flex-grow-1">
                @RenderBody()
            </div>

            <footer class="border-top text-muted mt-auto">
                <div class="container-fluid p-4 d-flex justify-content-between align-items-center">
                    <span>&copy; 2026 - LargeFantasyModel</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a>
                </div>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        <script src="~/js/GlobalSignalR.js" asp-append-version="true"></script>
    }
</body>
</html>