@model IEnumerable<large_fantasy_model.Models.Notification>

<li class="nav-item dropdown me-3">
    <a class="nav-link text-dark position-relative p-2" href="#" id="notificationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell-fill fs-5"></i>
        @if (Model.Any())
        {
            <span id="bell-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                @Model.Count()
            </span>
        }
    </a>
    
    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 rounded-4 p-2" aria-labelledby="notificationsDropdown" style="width: 320px; max-height: 400px; overflow-y: auto;">
        <li><h6 class="dropdown-header text-primary fw-bold fs-6">Notifications</h6></li>
        
        @if (!Model.Any())
        {
            <li class="text-center p-3 text-muted small">
                No new notifications
            </li>
        }
        else
        {
            @foreach (var notification in Model)
            {
                <li class="mb-2 position-relative">
        
                    <div class="rounded-3 text-wrap p-2 notification-item-card pe-4" style="white-space: normal; cursor: default;">
            
                        <form asp-controller="Game" asp-action="DeleteNotification" method="post" class="position-absolute top-0 end-0 mt-2 me-3">
                            <input type="hidden" name="notificationId" value="@notification.Id" />
                            <button type="submit" class="btn btn-sm text-muted p-0 border-0 bg-transparent shadow-none" style="transition: color 0.2s;" onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color=''">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>

                        <small class="d-block text-muted mb-1">
                            <i class="bi bi-clock"></i> @notification.CreatedAt.ToString("HH:mm")
                        </small>
            
                        <span><strong>@(notification.Sender?.Username ?? "System")</strong> @notification.Message</span>

                        @if (notification.Type == "GameInvite")
                        {
                            <div class="d-flex gap-2 mt-2">
                                <form asp-controller="Game" asp-action="AcceptGameInvite" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-success w-100 fw-bold">Accept</button>
                                </form>
                                <form asp-controller="Game" asp-action="RejectNotification" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">Decline</button>
                                </form>
                            </div>
                        }
                        else if (notification.Type == "FriendRequest")
                        {
                            <div class="d-flex gap-2 mt-2">
                                <form asp-controller="Profile" asp-action="AcceptFriendInvite" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">Accept</button>
                                </form>
                                <form asp-controller="Profile" asp-action="DeclineFriendInvite" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">Decline</button>
                                </form>
                            </div>
                        }
                    </div>
                </li>
            }
        }
    </ul>
</li>
@section Styles {
    <style>
        .notification-item-card {
            background-color: #f8f9fa;
            transition: background-color 0.2s ease-in-out !important;
            transform: none !important;
        }
    
            .notification-item-card:hover {
                background-color: #e9ecef !important;
                transform: none !important;
            }
    </style>

}

