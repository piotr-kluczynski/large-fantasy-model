@model IEnumerable<large_fantasy_model.Models.Notification>

<div class="w-100">
    <a class="btn shadow-sm w-100 d-flex align-items-center justify-content-center position-relative" style="height: 45px; border-radius: 12px; background-color: #fff; border: 1px solid #eaeaea; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--blame-main)'" onmouseout="this.style.borderColor='#eaeaea'" href="#notificationsOffcanvas" data-bs-toggle="offcanvas" role="button" aria-controls="notificationsOffcanvas">
        <i class="bi bi-bell-fill fs-5" style="color: var(--blame-side-dark);"></i>
        @if (Model.Any())
        {
            <span id="bell-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill" style="background: var(--blame-gradient); font-size: 0.65rem; margin-left: -12px; margin-top: 5px; box-shadow: 0 2px 5px rgba(227, 19, 23, 0.3);">
                @Model.Count()
            </span>
        }
    </a>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="notificationsOffcanvas" aria-labelledby="notificationsOffcanvasLabel" style="border-left: none; box-shadow: -5px 0 15px rgba(0,0,0,0.05);">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="notificationsOffcanvasLabel" style="color: var(--blame-main); font-weight: bold; font-size: 1.2rem;">
            <i class="bi bi-bell-fill me-2"></i>Notifications
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
        <ul class="list-unstyled m-0 p-0">
        
        @if (!Model.Any())
        {
            <li class="text-center p-3 text-muted small">
                No new notifications
            </li>
        }
        else
        {
            @foreach (var notification in Model)
            {
                <li class="mb-2 position-relative">
        
                    <div class="rounded-3 text-wrap p-2 notification-item-card pe-4" style="white-space: normal; cursor: default;">
            
                        <form asp-controller="Game" asp-action="DeleteNotification" method="post" class="position-absolute top-0 end-0 mt-2 me-3">
                            <input type="hidden" name="notificationId" value="@notification.Id" />
                            <button type="submit" class="btn btn-sm text-muted p-0 border-0 bg-transparent shadow-none" style="transition: color 0.2s;" onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color=''">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>

                        <small class="d-block text-muted mb-1">
                            <i class="bi bi-clock"></i> @notification.CreatedAt.ToString("HH:mm")
                        </small>
            
                        <span><strong>@(notification.Sender?.Username ?? "System")</strong> @notification.Message</span>

                        @if (notification.Type == "GameInvite")
                        {
                            <div class="d-flex gap-2 mt-2">
                                <form asp-controller="Game" asp-action="AcceptGameInvite" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-success w-100 fw-bold">Accept</button>
                                </form>
                                <form asp-controller="Game" asp-action="RejectNotification" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">Decline</button>
                                </form>
                            </div>
                        }
                        else if (notification.Type == "FriendRequest")
                        {
                            <div class="d-flex gap-2 mt-2">
                                <form asp-controller="Profile" asp-action="AcceptFriendInvite" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold" style="background: var(--blame-gradient); border: none;">Accept</button>
                                </form>
                                <form asp-controller="Profile" asp-action="DeclineFriendInvite" method="post" class="flex-grow-1">
                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">Decline</button>
                                </form>
                            </div>
                        }
                    </div>
                </li>
            }
        }
        </ul>
    </div>
</div>
@section Styles {
    <style>
        .notification-item-card {
            background-color: #f8f9fa;
            transition: background-color 0.2s ease-in-out !important;
            transform: none !important;
        }
    
            .notification-item-card:hover {
                background-color: #e9ecef !important;
                transform: none !important;
            }
    </style>

}

