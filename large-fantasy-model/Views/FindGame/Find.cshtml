@model large_fantasy_model.ViewModels.FindGameViewModel

@{
    ViewData["Title"] = "Find Game";
}

<div class="container mt-5">
   
    <div class="row justify-content-center text-center mb-4 mt-3">
        <div class="col-lg-8">
            <i class="bi bi-compass mb-3" style="font-size: 3.5rem; background: var(--blame-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;"></i>
            <h1 class="display-5 fw-bold mb-3" style="color: var(--blame-side-dark); letter-spacing: -1px;">Find Adventure</h1>
            <p class="lead text-secondary">Discover new worlds, join epic campaigns, or enter a secret invite code.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["DangerMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <strong>Error.</strong> @TempData["DangerMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            
            <!-- Sleek Search Bar -->
            <div class="card rounded-pill overflow-hidden mb-5" style="border: 1px solid rgba(174, 26, 103, 0.2) !important; box-shadow: 0 15px 35px rgba(174, 26, 103, 0.1) !important;"> 
                <form asp-controller="FindGame" asp-action="Find" method="get" class="d-flex m-0 p-2 align-items-center bg-white">
                    <span class="bg-white border-0 ps-4 pe-3 d-flex align-items-center fs-3" style="color: var(--blame-main);"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="SearchQuery" class="form-control form-control-lg border-0 bg-white py-3 fs-5 shadow-none w-100" placeholder="Search for public campaigns, keywords, or DM names...">
                    
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <a asp-action="Find" class="btn btn-light d-flex align-items-center rounded-circle me-3 text-muted" style="width: 45px; height: 45px; justify-content: center;">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                    <button class="btn btn-gradient fw-bold px-5 py-3 fs-5 rounded-pill shadow-sm me-1" type="submit">Search</button>
                </form>
            </div>

            <!-- Invite Code Card -->
            <div class="card border-0 rounded-4 p-3 px-md-4 shadow-sm" style="background: #ffffff; border: 1px solid #eaeaea !important;">
                <div class="row align-items-center">
                    <div class="col-md-6 text-md-start text-center mb-3 mb-md-0">
                        <div class="d-flex align-items-center justify-content-center justify-content-md-start">
                            <div class="feature-icon-small d-inline-flex align-items-center justify-content-center rounded-3 me-3" style="width: 40px; height: 40px; background: rgba(174, 26, 103, 0.1); color: var(--blame-main);">
                                <i class="bi bi-key-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">Have a Secret Invite Code?</h6>
                                <small class="text-muted">Enter the 6-character code to join.</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <form asp-controller="Game" asp-action="JoinByCode" method="post" class="d-flex justify-content-center justify-content-md-end m-0 w-100">
                            <input type="text" name="code" class="form-control form-control-lg text-center text-uppercase fw-bold bg-light me-2 border-0 shadow-none w-100" placeholder="A7B9F2" maxlength="6" style="letter-spacing: 5px;" required />
                            <button type="submit" class="btn btn-gradient fw-bold px-4 rounded-3 shadow-sm">Join</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div id="games-list-container" class="d-flex flex-column gap-3">
        @if (!Model.Games.Any())
        {
            <div class="text-center text-muted py-5">
                <div class="display-3 mb-3"><i class="bi bi-binoculars"></i></div>
                <h4>No campaigns found.</h4>
                <p>Try adjusting your search criteria or create your own game!</p>
            </div>
        }
        else
        {
            @foreach (var game in Model.Games)
            {
                
                bool isFull = game.PlayerCount >= game.MaxPlayers;

                <div class="card shadow-sm border-0 rounded-4 transition-hover">
                    <div class="card-body p-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
                        
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <h4 class="fw-bold mb-0">@game.Name</h4>
                                @if (game.IsPublic)
                                {
                                    <span class="badge rounded-pill px-3 py-2 border shadow-sm" style="color: var(--blame-main); background: rgba(174, 26, 103, 0.05); border-color: var(--blame-main) !important; letter-spacing: 0.5px;">
                                        <i class="bi bi-globe me-1"></i> Public
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2 bg-light text-secondary border shadow-sm" style="letter-spacing: 0.5px;">
                                        <i class="bi bi-lock-fill me-1"></i> Private
                                    </span>
                                }
                                @if (isFull)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm text-white" style="letter-spacing: 0.5px;">FULL</span>
                                }
                            </div>
                            <p class="text-secondary mb-2" style="font-size: 0.95rem; line-height: 1.6;">
                                @(game.Description.Length > 150 ? game.Description.Substring(0, 150) + "..." : game.Description)
                            </p>
                            <div class="d-flex flex-wrap gap-3 text-secondary small fw-semibold mt-3">
                                <div class="d-flex align-items-center bg-light px-3 py-2 rounded-pill">
                                    <i class="bi bi-person-fill me-2" style="color: var(--blame-main);"></i> Host: @game.DungeonMasterName
                                </div>
                                <div class="d-flex align-items-center px-3 py-2 rounded-pill @(isFull ? "bg-danger text-white shadow-sm" : "bg-light")">
                                    <i class="bi bi-people-fill me-2 @(isFull ? "text-white" : "")" style="@(!isFull ? "color: var(--blame-main);" : "")"></i> Players: @game.PlayerCount / @game.MaxPlayers
                                </div>
                                <div class="d-flex align-items-center bg-light px-3 py-2 rounded-pill">
                                    <i class="bi bi-calendar3 me-2" style="color: var(--blame-main);"></i> @game.CreationDate.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                        </div>

                        <div class="text-lg-end" style="min-width: 200px;">
                         @if (game.IsAlreadyMember)
                         {
                            <div class="mb-2">
                                <span class="badge bg-white text-dark rounded-pill px-3 py-1 w-100">
                                    <i class="bi bi-check-circle-fill me-1"></i> Already a Member
                                </span>
                            </div>
                            <a asp-controller="Game" asp-action="LobbyDetails" asp-route-id="@game.Id" class="btn btn-gradient btn-lg rounded-pill fw-bold w-100 py-2 shadow-sm">Enter Lobby</a>
                         }
                         else if (isFull)
                         {
                            <button class="btn btn-outline-secondary btn-lg rounded-pill fw-bold w-100 disabled" disabled>
                                Lobby Full
                            </button>
                         }
                         else if (game.HasPassword)
                         {
                            <button type="button" 
                                class="btn btn-outline-blame btn-lg rounded-pill fw-bold w-100 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#joinPasswordModal-@game.Id">
                                Join (Password)
                            </button>
                         }
                         else
                         {
                            <form asp-controller="FindGame" asp-action="JoinCampaign" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="gameId" value="@game.Id" />
                                <button type="submit" class="btn btn-outline-blame btn-lg rounded-pill fw-bold w-100 py-2 shadow-sm">Join Campaign</button>
                            </form>
                         }
                        </div>
                    </div>
                </div>

                @if (!game.IsAlreadyMember && game.HasPassword && !isFull)
                {
                    <div class="modal fade" id="joinPasswordModal-@game.Id" tabindex="-1" aria-labelledby="modalLabel-@game.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow-lg">
                                <div class="modal-header border-0 bg-warning text-dark rounded-top-4 pb-3 pt-4">
                                    <h5 class="modal-title fw-bold" id="modalLabel-@game.Id"><i class="bi bi-shield-lock-fill fs-4 me-2"></i> Protected Campaign</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form asp-controller="FindGame" asp-action="JoinCampaignWithPassword" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body p-4">
                                        <p class="text-muted mb-4">The campaign <strong>@game.Name</strong> requires a password to join. Please enter it below.</p>
                                        <input type="hidden" name="gameId" value="@game.Id" />
                                        <div class="form-floating mb-3">
                                            <input type="password" name="password" class="form-control rounded-3" id="passwordInput-@game.Id" placeholder="Password" required>
                                            <label for="passwordInput-@game.Id">Lobby Password</label>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-between">
                                        <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-warning text-dark rounded-pill fw-bold px-4">Enter Campaign</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>
@section Styles {
    <style>
        .transition-hover {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .transition-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
    <script src="~/js/Find.js"></script>
}