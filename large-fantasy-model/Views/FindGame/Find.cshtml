@model large_fantasy_model.ViewModels.FindGameViewModel

@{
    ViewData["Title"] = "Find Game";
}

<div class="container mt-5">
   
    <div class="row justify-content-center text-center mb-4">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold fantasy-font text-primary mb-3">Find Adventure</h1>
            <p class="lead text-secondary">Discover new worlds, join epic campaigns, or enter a secret invite code.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["DangerMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <strong>Error.</strong> @TempData["DangerMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="card border-primary border-3 rounded-pill shadow-lg overflow-hidden mb-5"> 
                <form asp-controller="FindGame" asp-action="Find" method="get" class="d-flex m-0">
                    <span class="bg-white border-0 text-primary ps-4 pe-2 d-flex align-items-center fs-4"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="SearchQuery" class="form-control form-control-lg border-0 bg-white py-2 fs-5 shadow-none w-100" style="box-shadow: none;" placeholder="Search campaigns by name...">
                    
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <a asp-action="Find" class="btn btn-light d-flex align-items-center border-start rounded-0 px-4 text-muted fs-5">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                    <button class="btn btn-primary fw-bold px-5 fs-5 rounded-0" type="submit">Search</button>
                </form>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-9 col-lg-7"> 
                    <div class="card border-0 bg-light rounded-4 shadow-sm p-3 text-center">
                        <h6 class="fw-bold text-dark mb-3"> Have an Invite Code?</h6>
                        <form asp-controller="Game" asp-action="JoinByCode" method="post" class="d-flex justify-content-center px-2">
                            <input type="text" name="code" class="form-control text-center text-uppercase fw-bold border-secondary bg-white w-100" placeholder="A7B9F2" maxlength="6" style="letter-spacing: 2px;" required />
                            <button type="submit" class="btn btn-dark fw-bold ms-2 px-4 rounded-3 shadow-sm">Join</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="games-list-container" class="d-flex flex-column gap-3">
        @if (!Model.Games.Any())
        {
            <div class="text-center text-muted py-5">
                <div class="display-3 mb-3"><i class="bi bi-binoculars"></i></div>
                <h4>No campaigns found.</h4>
                <p>Try adjusting your search criteria or create your own game!</p>
            </div>
        }
        else
        {
            @foreach (var game in Model.Games)
            {
                
                bool isFull = game.PlayerCount >= game.MaxPlayers;

                <div class="card shadow-sm border-0 rounded-4 transition-hover">
                    <div class="card-body p-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
                        
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <h4 class="fw-bold mb-0">@game.Name</h4>
                                @if (game.IsPublic)
                                {
                                    <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-globe"></i> Public</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-2 py-1"><i class="bi bi-lock-fill"></i> Private</span>
                                }
                                @if (isFull)
                                {
                                    <span class="badge bg-dark rounded-pill px-2 py-1">FULL</span>
                                }
                            </div>
                            <p class="text-muted mb-2">
                                @(game.Description.Length > 150 ? game.Description.Substring(0, 150) + "..." : game.Description)
                            </p>
                            <div class="d-flex gap-4 text-secondary small fw-semibold">
                                <span class="text-primary"><i class="bi bi-person-fill"></i> Host: @game.DungeonMasterName</span>
                                <span class="@(isFull ? "text-danger" : "text-success")">
                                   <i class="bi bi-people-fill"></i> Players: @game.PlayerCount / @game.MaxPlayers
                               </span>
                                <span><i class="bi bi-calendar-event"></i> Created: @game.CreationDate.ToString("MM/dd/yyyy")</span>
                            </div>
                        </div>

                        <div class="text-lg-end" style="min-width: 200px;">
                         @if (game.IsAlreadyMember)
                         {
                            <div class="mb-2">
                                <span class="badge bg-white text-dark rounded-pill px-3 py-1 w-100">
                                    <i class="bi bi-check-circle-fill me-1"></i> Already a Member
                                </span>
                            </div>
                            <a asp-controller="Game" asp-action="LobbyDetails" asp-route-id="@game.Id" class="btn btn-primary btn-lg rounded-pill fw-bold w-100">Enter Lobby</a>
                         }
                         else if (isFull)
                         {
                            <button class="btn btn-secondary btn-lg rounded-pill fw-bold w-100 disabled" disabled>
                                Lobby Full
                            </button>
                         }
                         else if (game.HasPassword)
                         {
                            <button type="button" 
                                class="btn btn-outline-primary btn-lg rounded-pill fw-bold w-100" data-bs-toggle="modal" data-bs-target="#joinPasswordModal-@game.Id">
                                Join (Password)
                            </button>
                         }
                         else
                         {
                            <form asp-controller="FindGame" asp-action="JoinCampaign" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="gameId" value="@game.Id" />
                                <button type="submit" class="btn btn-outline-primary btn-lg rounded-pill fw-bold w-100">Join Campaign</button>
                            </form>
                         }
                        </div>
                    </div>
                </div>

                @if (!game.IsAlreadyMember && game.HasPassword && !isFull)
                {
                    <div class="modal fade" id="joinPasswordModal-@game.Id" tabindex="-1" aria-labelledby="modalLabel-@game.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow-lg">
                                <div class="modal-header border-0 bg-warning text-dark rounded-top-4 pb-3 pt-4">
                                    <h5 class="modal-title fw-bold" id="modalLabel-@game.Id"><i class="bi bi-shield-lock-fill fs-4 me-2"></i> Protected Campaign</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form asp-controller="FindGame" asp-action="JoinCampaignWithPassword" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body p-4">
                                        <p class="text-muted mb-4">The campaign <strong>@game.Name</strong> requires a password to join. Please enter it below.</p>
                                        <input type="hidden" name="gameId" value="@game.Id" />
                                        <div class="form-floating mb-3">
                                            <input type="password" name="password" class="form-control rounded-3" id="passwordInput-@game.Id" placeholder="Password" required>
                                            <label for="passwordInput-@game.Id">Lobby Password</label>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-between">
                                        <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-warning text-dark rounded-pill fw-bold px-4">Enter Campaign</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>
@section Styles {
    <style>
        .transition-hover {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .transition-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
    <script src="~/js/Find.js"></script>
}