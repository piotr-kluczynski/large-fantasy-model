@model large_fantasy_model.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">
                Register to get started
            </h2>
            
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username<span class="text-danger">*</span></label>
                    <input asp-for="Username" class="form-control" placeholder="Your nickname" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">First Name<span class="text-danger">*</span></label>
                    <input asp-for="FirstName" class="form-control" placeholder="e.g. Geralt" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Last Name (Optional)</label>
                    <input asp-for="LastName" class="form-control" placeholder="e.g. of Rivia" />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-mail address<span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="np. player@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3 position-relative">
                    <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Enter your strong password" />
                    <span asp-validation-for="Password" class="text-danger"></span>

                    <div id="passwordChecklist" class="mt-2 p-3 bg-light rounded d-none border shadow-sm">
                        <h6 class="text-muted border-bottom pb-1 mb-2" style="font-size: 0.9rem;">Password Requirements:</h6>
                        <ul class="list-unstyled mb-0" style="font-size: 0.85rem; line-height: 1.6;">
                            <li id="check-length" class="text-danger transition-all">At least 8 characters</li>
                            <li id="check-upper" class="text-danger transition-all">At least 1 uppercase letter (A-Z)</li>
                            <li id="check-lower" class="text-danger transition-all">At least 1 lowercase letter (a-z)</li>
                            <li id="check-number" class="text-danger transition-all">At least 1 number (0-9)</li>
                        </ul>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your strong password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Register now</button>
            </form>

            @section Scripts {
                <partial name="_ValidationScriptsPartial" />

                <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    const passwordInput = document.getElementById('passwordInput');
                                    const checklistContainer = document.getElementById('passwordChecklist');
                                    const requirements = {
                                        length: document.getElementById('check-length'),
                                        upper: document.getElementById('check-upper'),
                                        lower: document.getElementById('check-lower'),
                                        number: document.getElementById('check-number')
                                    };

                                    function updateRequirement(element, isValid) {
                                        if (isValid) {
                                            // Usuwamy czerwony, dodajemy zielony (text-success z Bootstrapa)
                                            element.classList.remove('text-danger');
                                            element.classList.add('text-success');
                                        } else {
                                            // Wracamy do czerwonego
                                            element.classList.remove('text-success');
                                            element.classList.add('text-danger');
                                        }
                                    }

                                    function checkPasswordStrength() {
                                        const val = passwordInput.value;
                                        if (val.length > 0) {
                                            checklistContainer.classList.remove('d-none');
                                        } else {
                                            checklistContainer.classList.add('d-none');
                                        }

                                        updateRequirement(requirements.length, val.length >= 8);
                                        updateRequirement(requirements.upper, /[A-Z]/.test(val));
                                        updateRequirement(requirements.lower, /[a-z]/.test(val));
                                        updateRequirement(requirements.number, /\d/.test(val));
                                    }

                                    passwordInput.addEventListener('input', checkPasswordStrength);
                                });
                </script>
    
                <style>
                                .transition-all {
                                    transition: all 0.2s ease-in-out;
                                }
                </style>
            }
            <div class="text-center mt-3">
                <p>
                    Already have an account? <a asp-controller="Auth" asp-action="Login">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>