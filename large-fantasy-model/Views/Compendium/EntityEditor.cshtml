@*
    Widok: EntityEditor

    Przeznaczenie:
    - Uniwersalny widok, pozwalający na edycję/stworzenie elementu istniejącego systemu RPG

    Model:
    - EntityEditorViewModel

    Zachowanie:
    - Pozwala na zmianę wartości dowolnych pól opisujących elementy wybranego systemu RPG
    - Przyciskiem "Save" użytkownik może zmienić właściwości danego elementu (a w konsekwencji odpowiadającemu mu pliku JSON) 
      albo utworzenie nowego elementu (oraz pliku JSON)
    - Przyciskiem "Cancel" użytkownik anuluje wszelkie dokonane zmiany i zostaje przeniesiony do widoku Details danego systemu

*@

@using large_fantasy_model.ViewModels.Compendium
@model EntityEditorViewModel

<div class="container mt-4">
    <h2>@Model.Title</h2>

    <form asp-controller="Compendium" asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
        <input type="hidden" asp-for="Rulebook" />
        <input type="hidden" asp-for="Category" />

        @foreach (var field in Model.Fields)
        {
            <div class="mb-3">
                <label>@field.Label</label>

                @switch (field.Type)
                {
                    case "text":
                        @if (field.Key == "Name")
                        {
                            <input class="form-control" 
                                   name="Values[@field.Key]"
                                   value="@(Model.Values.ContainsKey(field.Key) ? Model.Values[field.Key] : "")"
                                   required pattern="^[a-zA-Z0-9 ]+$" title="Only letters, numbers, and spaces are allowed" />
                            @Html.ValidationMessage($"Values[{field.Key}]", "", new { @class = "text-danger" })
                        }
                        else
                        {
                            <input class="form-control" 
                                   name="Values[@field.Key]"
                                   value="@(Model.Values.ContainsKey(field.Key) ? Model.Values[field.Key] : "")" />
                        }
                        break;
                    
                    case "number":
                        <input type="number" 
                               class="form-control"
                               name="Values[@field.Key]"
                               value="@(Model.Values.ContainsKey(field.Key) ? Model.Values[field.Key] : "")" />
                        break;
                
                    case "textarea":
                        <textarea class="form-control"
                                  name="Values[@field.Key]">@(Model.Values.ContainsKey(field.Key) ? Model.Values[field.Key] : "")</textarea>
                        break;

                    case "checkbox":
                        <input type="checkbox" 
                               name="Values[@field.Key]" 
                               value="true"
                               @(Model.Values.ContainsKey(field.Key) && Model.Values[field.Key] == "Yes" ? "checked" : "") />
                        break;

                    case "entity-list":
                        @if (Model.AvailableOptions.ContainsKey(field.Key))
                        {
                            var selected = Model.ListValues.ContainsKey(field.Key)
                                ? Model.ListValues[field.Key]
                                : new List<string>();

                            <input type="text"
                                   class="form-control mb-2 entity-filter"
                                   placeholder="Search features..." />

                            <div class="border rounded p-2 entity-list-container" style="max-height:300px;overflow:auto">
                                @foreach (var option in Model.AvailableOptions[field.Key])
                                {
                                    <div class="form-check entity-option">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="ListValues[@field.Key]"
                                               value="@option.Value"
                                        @(selected.Contains(option.Value) ? "checked" : "") />

                                        <label class="form-check-label">
                                            @option.Label
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        break;
                }
            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            @if (Model.IsEdit && Model.Values.ContainsKey("Name"))
            {
                <a asp-action="Entity"
                   asp-route-rulebook="@Model.Rulebook"
                   asp-route-category="@Model.Category"
                   asp-route-name="@Model.Values["Name"].ToLower().Replace(" ", "-")"
                   class="btn btn-secondary">
                    Cancel
                </a>
            }
            else
            {
                <a asp-action="Details"
                   asp-route-id="1"
                   class="btn btn-secondary">
                   Cancel
               </a>
            }

            <button type="submit" class="btn btn-primary">
                Save
            </button>

        </div>
    </form>
</div>

<script>
    document.querySelectorAll('.entity-filter').forEach(filter => {
        filter.addEventListener('input', function () {

            const container =
                this.nextElementSibling;

            const text =
                this.value.toLowerCase();

            container.querySelectorAll('.entity-option')
                .forEach(option => {

                    const label =
                        option.innerText.toLowerCase();

                    option.style.display =
                        label.includes(text)
                            ? ''
                            : 'none';
                });
        });
    });
</script>