@using large_fantasy_model.ViewModels.Compendium
@model EntityEditorViewModel

<div class="container mt-4">
    <h2>@Model.Title</h2>

    <form asp-controller="Compendium" asp-action="Create" method="post">
        <input type="hidden" asp-for="Rulebook" />
        <input type="hidden" asp-for="Category" />

        @foreach (var field in Model.Fields)
        {
            <div class="mb-3">
                <label>@field.Label</label>

                @switch (field.Type)
                {
                    case "text":
                        <input class="form-control" name="Values[@field.Key]" />
                        break;
                    
                    case "number":
                        <input type="number" class="form-control" name="Values[@field.Key]" />
                        break;
                
                    case "textarea":
                        <textarea class="form-control" name="Values[@field.Key]"></textarea>
                        break;

                    case "checkbox":
                        <input type="checkbox" name="Values[@field.Key]" value="true" />
                        break;
                }
            </div>
        }

        <button class="btn btn-primary">Save</button>
    </form>
</div>