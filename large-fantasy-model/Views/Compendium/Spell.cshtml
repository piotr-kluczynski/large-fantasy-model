@using large_fantasy_model.Models.CharacterModels.Json
@model Spell

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.Name</h5>

        <div class="d-flex gap-1">
            @if (Model.Ritual)
            {
                <span class="badge bg-secondary">Ritual</span>
            }
            @if (Model.Concetration)
            {
                <span class="badge bg-warning text-dark">Concentration</span>
            }
        </div>
    </div>
    <p><strong>Level:</strong> @Model.Level</p>
    <p><strong>School:</strong> @Model.School</p>
    <p><strong>Casting Time:</strong> @Model.CastingTime</p>
    <p><strong>Range:</strong> @Model.RangeArea</p>
    <p><strong>Duration:</strong> @Model.Duration</p>

    <hr />

    <p>@Model.Description</p>

    @if (!string.IsNullOrEmpty(Model.HigherLevel))
    {
        <hr />
        <h5>At Higher Levels</h5>
        <p>@Model.HigherLevel</p>
    }

    <a asp-action="Details"
       asp-route-id="1"
       class="btn btn-secondary mt-3">
        Back to Rulebook
    </a>
</div>