

@using large_fantasy_model.Models.CharacterModels.Json
@using large_fantasy_model.Models.Compendium
@model GameModeRulebook
@{
    ViewData["Title"] = "Details    ";
}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm sticky-top" style="top: 20px;">
                <img src="~/imgs/@Model.IconEmoji" />
                <h3>@Model.Title</h3>
                <p class="text-muted">@Model.Description</p>

                <a href="~/pdfs/@Model.PdfFileName"
                   target="_blank"
                   class="btn btn-outline-blame w-100 mt-3 rounded-pill fw-bold">
                    Open Rulebook PDF
                </a>
            </div>
        </div>

        <div class="col-md-9">
            <ul class="nav nav-tabs" id="rulebookTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active"
                            data-bs-toggle="tab"
                            data-bs-target="#overview"
                            type="button">
                        Overview
                    </button>
                </li>

                @for (int i = 0; i < Model.Categories.Count; i++)
                {
                    var category = Model.Categories[i];

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                data-bs-toggle="tab"
                                data-bs-target="#@category.Key"
                                type="button">
                            @category.Title
                        </button>
                    </li>
                }
            </ul>

            <div class="tab-content border border-top-0 p-4">
                <div class="tab-pane fade show active" id="overview">
                    @foreach (var paragraph in Model.Overview)
                    {
                        <p>@Html.Raw(paragraph)</p>
                    }
                </div>

                @foreach (var category in Model.Categories)
                {
                    <div class="tab-pane fade show" id="@category.Key">
                        @if (category.Items.Any())
                        {
                            <div class="row">
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="col-md-4 mb-3">
                                        <a asp-controller="Compendium"
                                               asp-action="Create"
                                               asp-route-rulebook="@Model.FilesPathName"
                                               asp-route-category="@category.FilesPathName"
                                               class="text-decoration-none text-muted">

                                            <div class="card p-3 shadow-sm d-flex align-items-center justify-content-center h-100 border-dashed transition-hover" style="background-color: #f8f9fa;">
                                                <div class="text-center">
                                                    <h5 class="mb-0 fw-bold">+ Add @category.Title</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }

                                @foreach (var item in category.Items)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card p-3 shadow-sm">

                                            <a asp-controller="Compendium"
                                               asp-action="Entity"
                                               asp-route-rulebook="@item.Rulebook"
                                               asp-route-category="@item.Category"
                                               asp-route-name="@item.Slug"
                                               class="text-decoration-none text-primary">

                                                <h5 class="fw-bold mb-1">@item.Name</h5>
                                            </a>

                                            <small class="text-muted fw-semibold">@item.Subtitle</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>