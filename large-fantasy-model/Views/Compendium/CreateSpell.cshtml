@using large_fantasy_model.ViewModels
@using large_fantasy_model.ViewModels.Compendium
@model CreateSpellViewModel

<div class="container mt-4">
    <h2>Create Spell</h2>

    <form asp-controller"Compendium" asp-action="CreateSpell" method="post">
        <div class="mb-2">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-2">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="row">
            <div class="col">
                <label>Level</label>
                <input asp-for="Level" class="form-control" />
            </div>

            <div class="col">
                <label>School</label>
                <input asp-for="School" class="form-control" />
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label>Casting Time</label>
            <input asp-for="CastingTime" class="form-control" />
        </div>

        <div class="mb-2">
            <label>Range</label>
            <input asp-for="RangeArea" class="form-control" />
        </div>

        <div class="mb-2">
            <label>Duration</label>
            <input asp-for="Duration" class="form-control" />
        </div>

        <div class="form-check mb-2">
            <input asp-for="Ritual" class="form-check-input" />
            <label class="form-check-label">Ritual</label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Concentration" class="form-check-input" />
            <label class="form-check-label">Concentration</label>
        </div>

        <input type="hidden" asp-for="Rulebook" />
        <input type="hidden" asp-for="Category" />

        <button type="submit" class="btn btn-primary">
            Save Spell
        </button>

    </form>
</div>