@*
    Widok: EntityDetails

    Przeznaczenie:
    - Uniwersalny widok, pozwalający na inspekcję wartości wszystkich pól elementu istniejącego systemu RPG

    Model:
    - EntityDetailsViewModel

    Zachowanie:
    - Pozwala na zmianę wyświetlenie wszystkich pól wybranego elementu
    - Przycisk "Back" cofa użytkownika do widoku Details danego systemu RPG
    - Przycisk "Edit" przenosi użytkownika do widoku EntityEditor, który pozwala na zmianę wartości pól otwartego elementu

*@

@using large_fantasy_model.ViewModels.Compendium
@model EntityDetailsViewModel

<div class="container mt-4">

    <h2>@Model.Title</h2>

    <hr />

    @foreach (var field in Model.Fields)
    {
        @if (!string.IsNullOrWhiteSpace(field.Value))
        {
            <p>
                <strong>@field.Label:</strong> @field.Value
            </p>
        }
    }

    @foreach (var subList in Model.SubLists)
    {
        <div class="mt-3">
            <p><strong>@subList.Label:</strong></p>
            <ul>
                @foreach (var item in subList.Items)
                {
                    <li>
                        <a asp-action="Entity"
                           asp-route-rulebook="@item.Rulebook"
                           asp-route-category="@item.Category"
                           asp-route-name="@item.Slug">@item.Name</a>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="d-flex justify-content-between mt-4">
        <a asp-action="Details"
               asp-route-id="1"
               class="btn btn-secondary mt-3">
            Back
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit"
                   asp-route-rulebook="@Model.Rulebook"
                   asp-route-category="@Model.Category"
                   asp-route-name="@Model.Title.ToLower().Replace(" ", "-")"
                   class="btn btn-primary mt-3">
                Edit
            </a>
        }
    </div>

</div>