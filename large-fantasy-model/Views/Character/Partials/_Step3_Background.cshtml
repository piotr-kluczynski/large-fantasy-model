@using large_fantasy_model.ViewModels
@model CreateCharacterViewModel

<div class="wizard-step">
    <h3 class="mb-4">Choose Your Background</h3>
    <input asp-for="SelectedBackgroundName"
           type="hidden"
           id="selectedBackgroundInput" />

    <div id="backgroundAccordion">
        @for (int i = 0; i < Model.AvailableBackgrounds.Count; i++)
        {
            var characterBackground = Model.AvailableBackgrounds[i];
            var collapseId = $"background-details-{i}";

            <div class="card class-card mb-3">
                <div class="card-header p-0">
                    <button type="button"
                            class="btn w-100 text-start p-4 class-header-btn"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-1">@characterBackground.Name</h4>
                            </div>
                        </div>
                    </button>
                </div>
                <div id="@collapseId" class="collapse" data-bs-parent="#backgroundAccordion">
                    <div class="card-body">
                        <p>@characterBackground.Description</p>
                        <hr />
                        <h6>Background Features</h6>
                        <ul>
                            @foreach (var feature in characterBackground.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                        <button type="button"
                                class="btn btn-success select-background-btn mt-3"
                                data-background-name="@characterBackground.Name">
                            Select Background
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
