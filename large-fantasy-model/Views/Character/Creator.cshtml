@using large_fantasy_model.ViewModels
@model CreateCharacterViewModel

<form asp-action="Create" method="post" id="characterForm">
    <div class="card shadow">
        <div class="card-header">
            <h2>Create Character</h2>
        </div>
        <div class="card-body">
            
            <div class="progress mb-4">
                <div id="wizardProgress" class="progress-bar" style="width:14%"></div>
            </div>
            
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            @await Html.PartialAsync("Partials/_Step1_Class", Model)
            @await Html.PartialAsync("Partials/_Step2_Race", Model)
            @await Html.PartialAsync("Partials/_Step3_Background", Model)
            @await Html.PartialAsync("Partials/_Step4_AbilityScores", Model)
            @await Html.PartialAsync("Partials/_Step5_Skills", Model)
            @await Html.PartialAsync("Partials/_Step6_Spells", Model)
            @await Html.PartialAsync("Partials/_Step7_Equipment", Model)
            @await Html.PartialAsync("Partials/_Step8_About", Model)
            @await Html.PartialAsync("Partials/_Step9_Summary", Model)

        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <div>
                    <button type="button" id="cancelBtn" class="btn btn-danger">Cancel</button>
                    <button type="button" id="prevBtn" class="btn btn-secondary d-none">Previous</button>
                </div>
                <div>
                    <button type="button" id="nextBtn" class="btn btn-primary">Next</button>
                    <button type="submit" id="submitBtn" class="btn btn-success d-none">Create Character</button>
                </div>
            </div>
        </div>
    </div>
</form>

@await Html.PartialAsync("Partials/_CreatorScripts", Model)