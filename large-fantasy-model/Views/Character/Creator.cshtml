@using large_fantasy_model.ViewModels
@model CreateCharacterViewModel

<form asp-action="Create" method="post" id="characterForm">

    <div class="card shadow">

        <div class="card-header">
            <h2>Create Character</h2>
        </div>

        <div class="card-body">

            @* Progress *@
            <div class="progress mb-4">
                <div id="wizardProgress"
                     class="progress-bar"
                     style="width:14%">
                </div>
            </div>

            @* STEP 1 - Class *@
            <div class="wizard-step active">
                <h3 class="mb-4">Choose Your Class</h3>
                <input asp-for="SelectedClassName"
                       type="hidden"
                       id="selectedClassInput" />

                <div id="classAccordion">

                    @for (int i = 0; i < Model.AvailableClasses.Count; i++)
                    {
                        var characterClass = Model.AvailableClasses[i];
                        var collapseId = $"class-details-{i}";

                        <div class="card class-card mb-3">

                            <div class="card-header p-0">

                                <button type="button"
                                        class="btn w-100 text-start p-4 class-header-btn"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <h4 class="mb-1">
                                                @characterClass.Name
                                            </h4>

                                            @if (!string.IsNullOrWhiteSpace(characterClass.Spellcasting))
                                            {
                                                <span class="badge bg-primary">
                                                    Spellcaster
                                                </span>
                                            }
                                        </div>

                                        <div class="text-end">
                                            <small class="text-muted">
                                                Hit Die d@(characterClass.HitDie)
                                            </small>
                                        </div>

                                    </div>

                                </button>

                            </div>

                            <div id="@collapseId"
                                 class="collapse"
                                 data-bs-parent="#classAccordion">

                                <div class="card-body">

                                    <p>@characterClass.Description</p>

                                    <hr />

                                    <h6>Class Features</h6>

                                    <ul>
                                        @foreach (var feature in characterClass.Features)
                                        {
                                            <li>@feature</li>
                                        }
                                    </ul>

                                    <button type="button"
                                            class="btn btn-success select-class-btn mt-3"
                                            data-class-name="@characterClass.Name"
                                            data-spellcaster="@(!string.IsNullOrWhiteSpace(characterClass.Spellcasting)).ToString().ToLower()">
                                        Select Class
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* STEP 2 - Race *@
            <div class="wizard-step">
                <h3 class="mb-4">Choose Your Race</h3>
                <input asp-for="SelectedRaceName"
                       type="hidden"
                       id="selectedRaceInput" />

                <div id="raceAccordion">

                    @for (int i = 0; i < Model.AvailableRaces.Count; i++)
                    {
                        var characterRace = Model.AvailableRaces[i];
                        var collapseId = $"race-details-{i}";

                        <div class="card class-card mb-3">

                            <div class="card-header p-0">

                                <button type="button"
                                        class="btn w-100 text-start p-4 class-header-btn"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <h4 class="mb-1">
                                                @characterRace.Name
                                            </h4>
                                        </div>

                                        <div class="text-end">
                                            <small class="text-muted">
                                                Size: @characterRace.Size
                                            </small>
                                        </div>

                                    </div>

                                </button>

                            </div>

                            <div id="@collapseId"
                                 class="collapse"
                                 data-bs-parent="#raceAccordion">

                                <div class="card-body">

                                    <p>@characterRace.Description</p>

                                    <hr />

                                    <h6>Race Traits</h6>

                                    <ul>
                                        @foreach (var feature in characterRace.Features)
                                        {
                                            <li>@feature</li>
                                        }
                                    </ul>

                                    <button type="button"
                                            class="btn btn-success select-race-btn mt-3"
                                            data-race-name="@characterRace.Name">
                                        Select Race
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* STEP 3 - Background *@
            <div class="wizard-step">
                <h3 class="mb-4">Choose Your Background</h3>
                <input asp-for="SelectedBackgroundName"
                       type="hidden"
                       id="selectedBackgroundInput" />

                <div id="backgroundAccordion">

                    @for (int i = 0; i < Model.AvailableBackgrounds.Count; i++)
                    {
                        var characterBackground = Model.AvailableBackgrounds[i];
                        var collapseId = $"background-details-{i}";

                        <div class="card class-card mb-3">

                            <div class="card-header p-0">

                                <button type="button"
                                        class="btn w-100 text-start p-4 class-header-btn"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <h4 class="mb-1">
                                                @characterBackground.Name
                                            </h4>
                                        </div>

                                    </div>

                                </button>

                            </div>

                            <div id="@collapseId"
                                 class="collapse"
                                 data-bs-parent="#backgroundAccordion">

                                <div class="card-body">

                                    <p>@characterBackground.Description</p>

                                    <hr />

                                    <h6>Background Features</h6>

                                    <ul>
                                        @foreach (var feature in characterBackground.Features)
                                        {
                                            <li>@feature</li>
                                        }
                                    </ul>

                                    <button type="button"
                                            class="btn btn-success select-background-btn mt-3"
                                            data-background-name="@characterBackground.Name">
                                        Select Background
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* STEP 4 - Ability Scores *@
            <div class="wizard-step">

                <h3 class="mb-4">Ability Scores</h3>

                <div class="alert alert-secondary">
                    Enter values freely (recommended: 8–18)
                </div>

                <div class="row">

                    @* STR *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Strength</label>
                        <input id="Strength" asp-for="Strength"
                               type="number"
                               class="form-control"
                               min="1"
                               max="30" />
                    </div>

                    @* DEX *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Dexterity</label>
                        <input id="Dexterity" asp-for="Dexterity"
                               type="number"
                               class="form-control"
                               min="1"
                               max="30" />
                    </div>

                    @* CON *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Constitution</label>
                        <input id="Constitution" asp-for="Constitution"
                               type="number"
                               class="form-control"
                               min="1"
                               max="30" />
                    </div>

                    @* INT *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Intelligence</label>
                        <input id="Intelligence" asp-for="Intelligence"
                               type="number"
                               class="form-control"
                               min="1"
                               max="30" />
                    </div>

                    @* WIS *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Wisdom</label>
                        <input id="Wisdom" asp-for="Wisdom"
                               type="number"
                               class="form-control"
                               min="1"
                               max="30" />
                    </div>

                    @* CHA *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Charisma</label>
                        <input id="Charisma" asp-for="Charisma"
                               type="number"
                               class="form-control"
                               min="1"
                               max="30" />
                    </div>
                </div>

                @* Saving Throws *@
                <div class="card mt-4">

                    <div class="card-header">
                        <h5>Saving Throws</h5>
                        <small class="text-muted">
                            Select proficiencies
                        </small>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            @* STR *@
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input id="StrengthSave" asp-for="StrengthSave"
                                           class="form-check-input"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Strength Save
                                    </label>
                                </div>
                            </div>

                            @* DEX *@
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input id="DexteritySave" asp-for="DexteritySave"
                                           class="form-check-input"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Dexterity Save
                                    </label>
                                </div>
                            </div>

                            @* CON *@
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input id="ConstitutionSave" asp-for="ConstitutionSave"
                                           class="form-check-input"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Constitution Save
                                    </label>
                                </div>
                            </div>

                            @* INT *@
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input id="IntelligenceSave" asp-for="IntelligenceSave"
                                           class="form-check-input"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Intelligence Save
                                    </label>
                                </div>
                            </div>

                            @* WIS *@
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input id="WisdomSave" asp-for="WisdomSave"
                                           class="form-check-input"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Wisdom Save
                                    </label>
                                </div>
                            </div>

                            @* CHA *@
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input id="CharismaSave" asp-for="CharismaSave"
                                           class="form-check-input"
                                           type="checkbox"/>
                                    <label class="form-check-label">
                                        Charisma Save
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* STEP 5 - Skills *@
            <div class="wizard-step">

                <h3 class="mb-4">Skills</h3>

                <div class="row">

                    @* Strength *@
                    <div class="col-lg-4 mb-3">
                        <div class="card h-100">

                            <div class="card-header">
                                <strong>Strength</strong>
                            </div>

                            <div class="card-body">

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="athletics" />
                                        Athletics
                                    </label>
                                    <span id="athleticsValue" class="badge bg-dark">+0</span>
                                </div>

                            </div>
                        </div>
                    </div>

                    @* Dexterity *@
                    <div class="col-lg-4 mb-3">
                        <div class="card h-100">

                            <div class="card-header">
                                <strong>Dexterity</strong>
                            </div>

                            <div class="card-body">

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="acrobatics" />
                                        Acrobatics
                                    </label>
                                    <span id="acrobaticsValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="sleight" />
                                        Sleight of Hand
                                    </label>
                                    <span id="sleightValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="stealth" />
                                        Stealth
                                    </label>
                                    <span id="stealthValue" class="badge bg-dark">+0</span>
                                </div>

                            </div>
                        </div>
                    </div>

                    @* Intelligence *@
                    <div class="col-lg-4 mb-3">
                        <div class="card h-100">

                            <div class="card-header">
                                <strong>Intelligence</strong>
                            </div>

                            <div class="card-body">

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="arcana" />
                                        Arcana
                                    </label>
                                    <span id="arcanaValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="history" />
                                        History
                                    </label>
                                    <span id="historyValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="investigation" />
                                        Investigation
                                    </label>
                                    <span id="investigationValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="nature" />
                                        Nature
                                    </label>
                                    <span id="natureValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="religion" />
                                        Religion
                                    </label>
                                    <span id="religionValue" class="badge bg-dark">+0</span>
                                </div>

                            </div>
                        </div>
                    </div>

                    @* Wisdom *@
                    <div class="col-lg-6 mb-3">
                        <div class="card h-100">

                            <div class="card-header">
                                <strong>Wisdom</strong>
                            </div>

                            <div class="card-body">

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="animal" />
                                        Animal Handling
                                    </label>
                                    <span id="animalValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="insight" />
                                        Insight
                                    </label>
                                    <span id="insightValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="medicine" />
                                        Medicine
                                    </label>
                                    <span id="medicineValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="perception" />
                                        Perception
                                    </label>
                                    <span id="perceptionValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="survival" />
                                        Survival
                                    </label>
                                    <span id="survivalValue" class="badge bg-dark">+0</span>
                                </div>

                            </div>
                        </div>
                    </div>

                    @* Charisma *@
                    <div class="col-lg-6 mb-3">
                        <div class="card h-100">

                            <div class="card-header">
                                <strong>Charisma</strong>
                            </div>

                            <div class="card-body">

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="deception" />
                                        Deception
                                    </label>
                                    <span id="deceptionValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="intimidation" />
                                        Intimidation
                                    </label>
                                    <span id="intimidationValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="performance" />
                                        Performance
                                    </label>
                                    <span id="performanceValue" class="badge bg-dark">+0</span>
                                </div>

                                <div class="skill-row">
                                    <label>
                                        <input type="checkbox" class="skill-prof" data-skill="persuasion" />
                                        Persuasion
                                    </label>
                                    <span id="persuasionValue" class="badge bg-dark">+0</span>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>

            @* STEP 6 - Spells *@
            <div class="wizard-step">

                <h3 class="mb-4">Choose Spells</h3>

                <input asp-for="SelectedSpellNames"
                       type="hidden"
                       id="selectedSpellsInput" 
                       name="SelectedSpellNames" />

                <div class="row">

                    @* Available Spells *@
                    <div class="col-md-6">

                        <div class="card h-100">

                            <div class="card-header">
                                <h5>Available Spells</h5>
                            </div>

                            <div class="card-body spell-list">

                                @foreach (var spell in Model.AvailableSpells.OrderBy(s => s.Name))
                                {
                                    <div class="spell-card card mb-2"
                                         data-spell-name="@spell.Name">

                                        <div class="card-body">

                                            <div class="d-flex justify-content-between">

                                                <strong>
                                                    @spell.Name
                                                </strong>

                                                <span class="badge bg-secondary">
                                                    @spell.Level
                                                </span>

                                            </div>

                                            <small>
                                                @spell.School
                                            </small>

                                            <div class="collapse mt-3"
                                                 id="spell-@spell.Name.Replace(" ", "-")">

                                                <hr />

                                                <p>
                                                    @spell.Description
                                                </p>

                                                <ul class="list-unstyled">

                                                    <li>
                                                        <strong>Casting Time:</strong>
                                                        @spell.CastingTime
                                                    </li>

                                                    <li>
                                                        <strong>Range:</strong>
                                                        @spell.RangeArea
                                                    </li>

                                                    <li>
                                                        <strong>Duration:</strong>
                                                        @spell.Duration
                                                    </li>

                                                </ul>

                                                <button type="button"
                                                        class="btn btn-success add-spell-btn"
                                                        data-spell-name="@spell.Name">
                                                    Add Spell
                                                </button>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    @* Selected Spells *@
                    <div class="col-md-6">

                        <div class="card h-100">

                            <div class="card-header">
                                <h5>Selected Spells</h5>
                            </div>

                            <div class="card-body">

                                <div id="selectedSpellsContainer">

                                    <p class="text-muted">
                                        No spells selected.
                                    </p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* STEP 7 - Equipment & Weapons *@
            <div class="wizard-step">

                <h3 class="mb-4">
                    Equipment & Weapons
                </h3>

                <input asp-for="SelectedWeaponNames"
                       type="hidden"
                       id="selectedWeaponsInput" />

                <input asp-for="SelectedItemNames"
                       type="hidden"
                       id="selectedItemsInput" />

                <div class="row">
                    @* Available Weapons/Items *@
                    <div class="col-lg-6">
                        <div class="card h-100">

                            <div class="card-header">
                                <h5>Available Equipment</h5>
                            </div>

                            <div class="card-body">
                                <h6 class="border-bottom pb-2">
                                    Weapons
                                </h6>
                                <div class="equipment-list">

                                    @foreach (var weapon in Model.AvailableWeapons.OrderBy(w => w.Name))
                                    {
                                        var collapseId =
                                            $"weapon-{weapon.Name.Replace(" ", "-")}";

                                        <div class="card mb-2">

                                            <div class="card-header">

                                                <button type="button"
                                                        class="btn w-100 text-start"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#@collapseId">

                                                    <strong>
                                                        @weapon.Name
                                                    </strong>

                                                </button>

                                            </div>

                                            <div id="@collapseId"
                                                 class="collapse">

                                                <div class="card-body">

                                                    <p>
                                                        @weapon.Description
                                                    </p>

                                                    <ul class="list-unstyled">

                                                        <li>
                                                            <strong>Damage:</strong>
                                                            @weapon.Damage
                                                        </li>

                                                        <li>
                                                            <strong>Range:</strong>
                                                            @weapon.Range
                                                        </li>

                                                        <li>
                                                            <strong>Weight:</strong>
                                                            @weapon.Weight
                                                        </li>

                                                    </ul>

                                                    <button type="button"
                                                            class="btn btn-success add-weapon-btn"
                                                            data-weapon-name="@weapon.Name">
                                                        Add Weapon
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <hr />

                                <h6 class="border-bottom pb-2">
                                    Items
                                </h6>

                                <div class="equipment-list">
                                    @foreach (var item in Model.AvailableItems.OrderBy(i => i.Name))
                                    {
                                        var collapseId =
                                            $"item-{item.Name.Replace(" ", "-")}";

                                        <div class="card mb-2">

                                            <div class="card-header">

                                                <button type="button"
                                                        class="btn w-100 text-start"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#@collapseId">

                                                    <strong>
                                                        @item.Name
                                                    </strong>

                                                </button>

                                            </div>

                                            <div id="@collapseId"
                                                 class="collapse">

                                                <div class="card-body">

                                                    <p>
                                                        @item.Description
                                                    </p>

                                                    <ul class="list-unstyled">

                                                        <li>
                                                            <strong>Weight:</strong>
                                                            @item.Weight
                                                        </li>

                                                        <li>
                                                            <strong>Magic:</strong>
                                                            @(item.Magic ? "Yes" : "No")
                                                        </li>

                                                    </ul>

                                                    <button type="button"
                                                            class="btn btn-success add-item-btn"
                                                            data-item-name="@item.Name">
                                                        Add Item
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Selected Weapons/Items*@

                    <div class="col-lg-6">

                        <div class="card h-100">

                            <div class="card-header">
                                <h5>Current Equipment</h5>
                            </div>

                            <div class="card-body">

                                <h6>Weapons</h6>

                                <div id="selectedWeaponsContainer">

                                    <p class="text-muted">
                                        No weapons selected.
                                    </p>

                                </div>

                                <hr />

                                <h6>Items</h6>

                                <div id="selectedItemsContainer">

                                    <p class="text-muted">
                                        No items selected.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* STEP 8 - About Character *@
            <div class="wizard-step">
                <h3 class="mb-4">About Your Character</h3>

                <div class="row">
                    @* Left column - Basic Identity *@
                    <div class="col-lg-6">

                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Basic Information</h5>
                            </div>

                            <div class="card-body">

                                <div class="mb-3">
                                    <label class="form-label">Character Name</label>
                                    <input id="Name" asp-for="Name" class="form-control" />
                                </div>

                                <div class="row">

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Age</label>
                                        <input id="Age" asp-for="Age" class="form-control" />
                                    </div>

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Alignment</label>
                                        <input id="Alignment" asp-for="Alignment" class="form-control" />
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <label class="form-label">Speed</label>
                                        <input id="Speed" asp-for="Speed" class="form-control" />
                                    </div>

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Armor Class</label>
                                        <input asp-for="ArmorClass" class="form-control" />
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Level</label>
                                        <input id="Level" asp-for="Level" class="form-control" placeholder="Level" />
                                    </div>

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Hit Points</label>
                                        <input asp-for="MaxHitPoints" class="form-control" placeholder="Max HP" />
                                    </div>

                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Inspiration</label>
                                    <input id="Inspiration" asp-for="Inspiration" class="form-control" />
                                </div>

                            </div>
                        </div>

                    </div>

                    @* Right column - Appearance *@
                    <div class="col-lg-6">

                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Appearance</h5>
                            </div>

                            <div class="card-body">

                                <div class="row">

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Height</label>
                                        <input id="Height" asp-for="Height" class="form-control" />
                                    </div>

                                    <div class="col-6 mb-3">
                                        <label class="form-label">Weight</label>
                                        <input id="Weight" asp-for="Weight" class="form-control" />
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-4 mb-3">
                                        <label class="form-label">Eyes</label>
                                        <input id="Eyes" asp-for="Eyes" class="form-control" />
                                    </div>

                                    <div class="col-4 mb-3">
                                        <label class="form-label">Hair</label>
                                        <input id="Hair" asp-for="Hair" class="form-control" />
                                    </div>

                                    <div class="col-4 mb-3">
                                        <label class="form-label">Skin</label>
                                        <input id="Skin" asp-for="Skin" class="form-control" />
                                    </div>

                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Physical Description</label>
                                    <textarea id="Physical" asp-for="Physical"
                                              class="form-control"
                                              rows="3"></textarea>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

                @* Roleplay Section *@
                <div class="card mt-3">

                    <div class="card-header">
                        <h5>Personality & Story</h5>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label class="form-label">Personality Traits</label>
                            <textarea id="Personality" asp-for="Personality"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Languages</label>
                            <textarea id="Languages" asp-for="Languages"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ideal</label>
                            <textarea id="Ideal" asp-for="Ideal"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Bond</label>
                            <textarea id="Bond" asp-for="Bond"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Flaw</label>
                            <textarea id="Flaw" asp-for="Flaw"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>


                        <div class="mb-3">
                            <label class="form-label">Backstory</label>
                            <textarea id="Backstory" asp-for="Backstory"
                                      class="form-control"
                                      rows="5"></textarea>
                        </div>

                    </div>

                </div>

            </div>

            @* STEP 9 - Summary *@
            <div class="wizard-step">

                <h2 class="mb-4">Character Summary</h2>

                <div class="row">

                    @* Left Column *@
                    <div class="col-lg-6">

                        @* Basic Info *@
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Identity</h5>
                            </div>

                            <div class="card-body">

                                <p id="nameSummary"><strong>Name:</strong> @Model.Name</p>
                                <p id="levelSummary"><strong>Level:</strong> @Model.Level</p>
                                <p id="classSummary"><strong>Class:</strong> @Model.SelectedClassName</p>
                                <p id="raceSummary"><strong>Race:</strong> @Model.SelectedRaceName</p>
                                <p id="backgroundSummary"><strong>Background:</strong> @Model.SelectedBackgroundName</p>
                                <p id="alignmentSummary"><strong>Alignment:</strong> @Model.Alignment</p>

                            </div>
                        </div>

                        @* Abilities *@
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Ability Scores</h5>
                            </div>

                            <div class="card-body">

                                <p id="strengthSummary">STR: <strong>@Model.Strength</strong></p>
                                <p id="dexteritySummary">DEX: <strong>@Model.Dexterity</strong></p>
                                <p id="constitutionSummary">CON: <strong>@Model.Constitution</strong></p>
                                <p id="intelligenceSummary">INT: <strong>@Model.Intelligence</strong></p>
                                <p id="wisdomSummary">WIS: <strong>@Model.Wisdom</strong></p>
                                <p id="charismaSummary">CHA: <strong>@Model.Charisma</strong></p>

                            </div>
                        </div>

                        @* Saving throws *@
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Saving Throws</h5>
                            </div>

                            <div class="card-body">

                                <p id="strengthSaveSummary">STR: @(Model.StrengthSave ? "Yes" : "No")</p>
                                <p id="dexteritySaveSummary">DEX: @(Model.DexteritySave ? "Yes" : "No")</p>
                                <p id="constitutionSaveSummary">CON: @(Model.ConstitutionSave ? "Yes" : "No")</p>
                                <p id="intelligenceSaveSummary">INT: @(Model.IntelligenceSave ? "Yes" : "No")</p>
                                <p id="wisdomSaveSummary">WIS: @(Model.WisdomSave ? "Yes" : "No")</p>
                                <p id="charismaSaveSummary">CHA: @(Model.CharismaSave ? "Yes" : "No")</p>

                            </div>
                        </div>

                    </div>

                    @* Right Columns *@
                    <div class="col-lg-6">

                        @* Combat Stats *@
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Combat Stats</h5>
                            </div>

                            <div class="card-body">

                                <p id="speedSummary"><strong>Speed:</strong> @Model.Speed</p>
                                <p id="inspirationSummary"><strong>Inspiration:</strong> @Model.Inspiration</p>

                            </div>
                        </div>

                        @* Equipment *@
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Equipment</h5>
                            </div>

                            <div class="card-body">

                                <p><strong>Weapons:</strong></p>
                                <ul id="weaponsSummary">
                                    @foreach (var w in Model.SelectedWeaponNames ?? new List<string>())
                                    {
                                        <li>@w</li>
                                    }
                                </ul>

                                <p><strong>Items:</strong></p>
                                <ul id="itemsSummary">
                                    @foreach (var i in Model.SelectedItemNames ?? new List<string>())
                                    {
                                        <li>@i</li>
                                    }
                                </ul>

                                @if (Model.IsSpellcaster)
                                {
                                    <p><strong>Spells:</strong></p>
                                    <ul id="spellsSummary">
                                        @foreach (var s in Model.SelectedSpellNames ?? new List<string>())
                                        {
                                            <li>@s</li>
                                        }
                                    </ul>
                                }

                            </div>
                        </div>

                        @* Character Details *@
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>Character Details</h5>
                            </div>

                            <div class="card-body">

                                <p id="ageSummary"><strong>Age:</strong> @Model.Age</p>
                                <p id="heightSummary"><strong>Height:</strong> @Model.Height</p>
                                <p id="weightSummary"><strong>Weight:</strong> @Model.Weight</p>
                                <p id="eyesSummary"><strong>Eyes:</strong> @Model.Eyes</p>
                                <p id="hairSummary"><strong>Hair:</strong> @Model.Hair</p>
                                <p id="skinSummary"><strong>Skin:</strong> @Model.Skin</p>

                            </div>
                        </div>

                    </div>
                </div>

                @* Roleplay *@
                <div class="card mt-3">

                    <div class="card-header">
                        <h5>Roleplay & Story</h5>
                    </div>

                    <div class="card-body">

                        <p id="personalitySummary"><strong>Personality:</strong> @Model.Personality</p>
                        <p id="languagesSummary"><strong>Languages:</strong>@Model.Languages</p>
                        <p id="idealSummary"><strong>Ideal:</strong> @Model.Ideal</p>
                        <p id="bondSummary"><strong>Bond:</strong> @Model.Bond</p>
                        <p id="flawSummary"><strong>Flaw:</strong> @Model.Flaw</p>

                        <hr />

                        <p><strong>Backstory:</strong></p>
                        <p id="backstorySummary">@Model.Backstory</p>

                        <hr />

                        <p><strong>Physical Description:</strong></p>
                        <p id="physicalSummary">@Model.Physical</p>

                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer">

            <div class="d-flex justify-content-between">

                <div>
                    <button type="button"
                            id="cancelBtn"
                            class="btn btn-danger">
                        Cancel
                    </button>

                    <button type="button"
                            id="prevBtn"
                            class="btn btn-secondary d-none">
                        Previous
                    </button>
                </div>

                <div>
                    <button type="button"
                            id="nextBtn"
                            class="btn btn-primary">
                        Next
                    </button>

                    <button type="submit"
                            id="submitBtn"
                            class="btn btn-success d-none">
                        Create Character
                    </button>
                </div>

            </div>

        </div>

    </div>
</form>
<script>
    const steps = document.querySelectorAll('.wizard-step');
    
    let currentStep = 0;

    const cancelBtn = document.getElementById('cancelBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const submitBtn = document.getElementById('submitBtn');
    const progressBar = document.getElementById('wizardProgress');

    let hasSpellcasting = false;
    const selectedWeapons = [];
    const selectedItems = [];

    // Select Class
    document.querySelectorAll('.select-class-btn')
    .forEach(button => {

        button.addEventListener('click', function () {

            const selectedClass =
                this.dataset.className;

            hasSpellcasting =
                this.dataset.spellcaster != "";

            document.getElementById(
                'selectedClassInput'
            ).value = selectedClass;

            document.querySelectorAll(
                '#classAccordion .class-card'
            ).forEach(card =>
                card.classList.remove('selected'));

            this.closest('.class-card')
                .classList.add('selected');
        });
    });


    // Select Race
    document.querySelectorAll('.select-race-btn')
    .forEach(button => {

        button.addEventListener('click', function () {

            const selectedRace =
                this.dataset.raceName;

            document.getElementById(
                'selectedRaceInput'
            ).value = selectedRace;

            document.querySelectorAll(
                '#raceAccordion .class-card'
            ).forEach(card =>
                card.classList.remove('selected'));

            this.closest('.class-card')
                .classList.add('selected');
        });
    });


    // Select Background
    document.querySelectorAll('.select-background-btn')
    .forEach(button => {

        button.addEventListener('click', function () {

            const selectedBackground =
                this.dataset.backgroundName;

            document.getElementById(
                'selectedBackgroundInput'
            ).value = selectedBackground;

            document.querySelectorAll(
                '#backgroundAccordion .class-card'
            ).forEach(card =>
                card.classList.remove('selected'));

            this.closest('.class-card')
                .classList.add('selected');
        });
    });

    // Select Abilities
    document.querySelectorAll('input[type="number"]').forEach(input => {

        input.addEventListener('change', () => {

            let value = parseInt(input.value);

            if (isNaN(value)) value = 10;

            if (value < 1) value = 1;
            if (value > 30) value = 30;

            input.value = value;
        });

    });

    // Select Skills
    const proficiencyBonus = 2;

    function getModifier(score) {
        return Math.floor((score - 10) / 2);
    }

    function getAbilityMods() {

        return {
            str: getModifier(parseInt(document.getElementById("Strength").value || 10)),
            dex: getModifier(parseInt(document.getElementById("Dexterity").value || 10)),
            int: getModifier(parseInt(document.getElementById("Intelligence").value || 10)),
            wis: getModifier(parseInt(document.getElementById("Wisdom").value || 10)),
            cha: getModifier(parseInt(document.getElementById("Charisma").value || 10))
        };
    }

    function updateSkills() {

        const mods = getAbilityMods();

        const mapping = {
            athletics: mods.str,

            acrobatics: mods.dex,
            sleight: mods.dex,
            stealth: mods.dex,

            arcana: mods.int,
            history: mods.int,
            investigation: mods.int,
            nature: mods.int,
            religion: mods.int,

            animal: mods.wis,
            insight: mods.wis,
            medicine: mods.wis,
            perception: mods.wis,
            survival: mods.wis,

            deception: mods.cha,
            intimidation: mods.cha,
            performance: mods.cha,
            persuasion: mods.cha
        };

        document.querySelectorAll('.skill-prof').forEach(cb => {

            const skill = cb.dataset.skill;
            const base = mapping[skill] ?? 0;
            const isProf = cb.checked;

            const total = base + (isProf ? proficiencyBonus : 0);

            const el = document.getElementById(skill + "Value");

            if (el) {
                el.innerText = (total >= 0 ? "+" : "") + total;
            }
        });
    }

    document.querySelectorAll('input[type="number"]').forEach(i => {
        i.addEventListener('input', updateSkills);
    });

    document.querySelectorAll('.skill-prof').forEach(cb => {
        cb.addEventListener('change', updateSkills);
    });

    updateSkills();

    // Select Weapons
    document.querySelectorAll('.add-weapon-btn')
    .forEach(button => {

        button.addEventListener('click', function () {

            const weaponName =
                this.dataset.weaponName;

            selectedWeapons.push(weaponName);

            renderWeapons();
        });
    });

    function renderWeapons()
    {
        const container =
            document.getElementById(
                'selectedWeaponsContainer'
            );

        if(selectedWeapons.length === 0)
        {
            container.innerHTML =
                '<p class="text-muted">No weapons selected.</p>';

            return;
        }

        container.innerHTML = '';

        selectedWeapons.forEach(weapon => {

            container.innerHTML += `
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between">

                        <span>${weapon}</span>

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="removeWeapon('${weapon}')">
                            Remove
                        </button>

                    </div>
                </div>
            `;
        });

        document.getElementById(
            'selectedWeaponsInput'
        ).value =
            JSON.stringify(selectedWeapons);
    }

    function removeWeapon(name)
    {
        const index =
            selectedWeapons.indexOf(name);

        if(index >= 0)
        {
            selectedWeapons.splice(index, 1);
        }

        renderWeapons();
    }

    // Select Items
    document.querySelectorAll('.add-item-btn')
    .forEach(button => {

        button.addEventListener('click', function () {

            const itemName =
                this.dataset.itemName;

            selectedItems.push(itemName);

            renderItems();
        });
    });

    function renderItems()
    {
        const container =
            document.getElementById(
                'selectedItemsContainer'
            );

        if(selectedItems.length === 0)
        {
            container.innerHTML =
                '<p class="text-muted">No items selected.</p>';

            return;
        }

        container.innerHTML = '';

        selectedItems.forEach(item => {

            container.innerHTML += `
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between">

                        <span>${item}</span>

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="removeItem('${item}')">
                            Remove
                        </button>

                    </div>
                </div>
            `;
        });

        document.getElementById(
            'selectedItemsInput'
        ).value =
            JSON.stringify(selectedItems);
    }

    function removeItem(name)
    {
        const index =
            selectedItems.indexOf(name);

        if(index >= 0)
        {
            selectedItems.splice(index, 1);
        }

        renderItems();
    }

    // Select Spells
    let selectedSpells = [];

    document.querySelectorAll('.spell-card')
        .forEach(card => {

            card.addEventListener('click', function(e) {

                if(e.target.classList.contains('add-spell-btn'))
                    return;

                const collapse =
                    this.querySelector('.collapse');

                bootstrap.Collapse.getOrCreateInstance(
                    collapse
                ).toggle();
            });
        }
    );

    document.querySelectorAll('.add-spell-btn')
        .forEach(button => {

            button.addEventListener('click', function() {

                const spellName =
                    this.dataset.spellName;

                if(selectedSpells.includes(spellName))
                    return;

                selectedSpells.push(spellName);

                renderSelectedSpells();
            });
        }
    );

    function renderSelectedSpells() {

        const container =
            document.getElementById(
                'selectedSpellsContainer'
            );

        if(selectedSpells.length === 0)
        {
            container.innerHTML =
                '<p class="text-muted">No spells selected.</p>';

            return;
        }

        container.innerHTML = '';

        selectedSpells.forEach(spell => {

            container.innerHTML += `
                <div class="card mb-2 selected-spell">
                    <div class="card-body d-flex justify-content-between align-items-center">

                        <span>${spell}</span>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="removeSpell('${spell}')">
                            Remove
                        </button>

                    </div>
                </div>
            `;
        });

        document.getElementById(
            'selectedSpellsInput'
        ).value =
            JSON.stringify(selectedSpells);
    }

    function removeSpell(spellName)
    {
        const index =
            selectedSpells.indexOf(spellName);

        if(index >= 0)
        {
            selectedSpells.splice(index, 1);
        }

        renderSelectedSpells();
    }

    function updateWizard() {

        steps.forEach(step =>
            step.classList.remove('active'));

        steps[currentStep].classList.add('active');

        prevBtn.classList.toggle(        
            'd-none',
            currentStep === 0
        );

        cancelBtn.classList.toggle(
            'd-none',
            currentStep !== 0
        );

        nextBtn.style.display =
            currentStep === steps.length - 1
            ? 'none'
            : 'inline-block';

        submitBtn.classList.toggle(
            'd-none',
            currentStep !== steps.length - 1
        );

        const percent =
            ((currentStep + 1) / steps.length) * 100;

        progressBar.style.width = percent + '%';
    }

    function updateSummary()
    {
        document.getElementById('backgroundSummary').innerHTML =
            `<strong>Name:</strong> ${document.getElementById('Name').value}`;

        document.getElementById('levelSummary').innerHTML =
            `<strong>Level:</strong> ${document.getElementById('Level').value}`;

        document.getElementById('classSummary').innerHTML =
            `<strong>Class:</strong> ${document.getElementById('selectedClassInput').value}`;

        document.getElementById('raceSummary').innerHTML =
            `<strong>Race:</strong> ${document.getElementById('selectedRaceInput').value}`;

        document.getElementById('backgroundSummary').innerHTML =
            `<strong>Background:</strong> ${document.getElementById('selectedBackgroundInput').value}`;

        document.getElementById('alignmentSummary').innerHTML =
            `<strong>Alignment:</strong> ${document.getElementById('Alignment').value}`;


        // Ability Scores

        document.getElementById('strengthSummary').innerHTML =
            `STR: <strong>${document.getElementById('Strength').value}</strong>`;

        document.getElementById('dexteritySummary').innerHTML =
            `DEX: <strong>${document.getElementById('Dexterity').value}</strong>`;

        document.getElementById('constitutionSummary').innerHTML =
            `CON: <strong>${document.getElementById('Constitution').value}</strong>`;

        document.getElementById('intelligenceSummary').innerHTML =
            `INT: <strong>${document.getElementById('Intelligence').value}</strong>`;

        document.getElementById('wisdomSummary').innerHTML =
            `WIS: <strong>${document.getElementById('Wisdom').value}</strong>`;

        document.getElementById('charismaSummary').innerHTML =
            `CHA: <strong>${document.getElementById('Charisma').value}</strong>`;


        // Saving Throws

        document.getElementById('strengthSaveSummary').textContent =
            `STR: ${document.getElementById('StrengthSave').checked ? 'Yes' : 'No'}`;

        document.getElementById('dexteritySaveSummary').textContent =
            `DEX: ${document.getElementById('DexteritySave').checked ? 'Yes' : 'No'}`;

        document.getElementById('constitutionSaveSummary').textContent =
            `CON: ${document.getElementById('ConstitutionSave').checked ? 'Yes' : 'No'}`;

        document.getElementById('intelligenceSaveSummary').textContent =
            `INT: ${document.getElementById('IntelligenceSave').checked ? 'Yes' : 'No'}`;

        document.getElementById('wisdomSaveSummary').textContent =
            `WIS: ${document.getElementById('WisdomSave').checked ? 'Yes' : 'No'}`;

        document.getElementById('charismaSaveSummary').textContent =
            `CHA: ${document.getElementById('CharismaSave').checked ? 'Yes' : 'No'}`;


        // Combat

        document.getElementById('speedSummary').innerHTML =
            `<strong>Speed:</strong> ${document.getElementById('Speed').value}`;

        document.getElementById('inspirationSummary').innerHTML =
            `<strong>Inspiration:</strong> ${document.getElementById('Inspiration').value}`;


        // Weapons
        document.getElementById('weaponsSummary').innerHTML =
                    selectedWeapons
                        .map(weapon => `<li>${weapon}</li>`)
                        .join('');

        // Equipment
        document.getElementById('itemsSummary').innerHTML =
            selectedItems
                .map(item => `<li>${item}</li>`)
                .join('');

        // Spells
        document.getElementById('spellsSummary').innerHTML = 
            selectedSpells
                .map(spell => `<li>${spell}</li>`)
                .join('');


        // Character Details

        document.getElementById('ageSummary').innerHTML =
            `<strong>Age:</strong> ${document.getElementById('Age').value}`;

        document.getElementById('heightSummary').innerHTML =
            `<strong>Height:</strong> ${document.getElementById('Height').value}`;

        document.getElementById('weightSummary').innerHTML =
            `<strong>Weight:</strong> ${document.getElementById('Weight').value}`;

        document.getElementById('eyesSummary').innerHTML =
            `<strong>Eyes:</strong> ${document.getElementById('Eyes').value}`;

        document.getElementById('hairSummary').innerHTML =
            `<strong>Hair:</strong> ${document.getElementById('Hair').value}`;

        document.getElementById('skinSummary').innerHTML =
            `<strong>Skin:</strong> ${document.getElementById('Skin').value}`;


        // Roleplay

        document.getElementById('personalitySummary').innerHTML =
            `<strong>Personality:</strong> ${document.getElementById('Personality').value}`;

        document.getElementById('idealSummary').innerHTML =
            `<strong>Ideal:</strong> ${document.getElementById('Ideal').value}`;

        document.getElementById('bondSummary').innerHTML =
            `<strong>Bond:</strong> ${document.getElementById('Bond').value}`;

        document.getElementById('flawSummary').innerHTML =
            `<strong>Flaw:</strong> ${document.getElementById('Flaw').value}`;

        document.getElementById('backstorySummary').textContent =
            document.getElementById('Backstory').value;

        document.getElementById('physicalSummary').textContent =
            document.getElementById('Physical').value;
    }

    nextBtn.addEventListener('click', () => {
        currentStep++;
        updateWizard();
    });

    prevBtn.addEventListener('click', () => {
        currentStep--;
        updateWizard();
    });

    cancelBtn.addEventListener('click', () => {
        window.location.href = '/Character';
    });

