@model IEnumerable<large_fantasy_model.Models.CharacterModels.Character>

@{
    ViewData["Title"] = "My Characters";
}

<div class="container mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 bg-white p-4 p-md-5 rounded-4 shadow-sm border-0 position-relative overflow-hidden">

        <i class="bi bi-shield-shaded position-absolute" style="font-size: 15rem; right: 10%; top: -50px; opacity: 0.02; color: var(--blame-main); transform: rotate(15deg);"></i>
        
        <div class="position-relative z-2 mb-4 mb-md-0">
            <h1 class="display-5 fw-bold mb-2" style="color: var(--blame-side-dark); letter-spacing: -1px;">
                <i class="bi bi-person-badge me-2" style="color: var(--blame-main);"></i>
                My Characters
            </h1>
            <p class="text-secondary fs-5 mb-0" style="max-width: 500px;">
                Forge your heroes, manage their equipment, and track their epic journeys.
            </p>
        </div>
        <div class="position-relative z-2">
            <a asp-controller="Character" asp-action="Create" class="btn btn-gradient rounded-pill fw-bold px-5 py-3 shadow-sm d-inline-flex align-items-center">
                <i class="bi bi-plus-circle-fill fs-5 me-2"></i> Create New Character
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm text-center p-5" style="background-color: #f8f9fa;">
            <div class="card-body py-5">
                <i class="bi bi-person-slash text-muted mb-3" style="font-size: 4rem;"></i>
                <h3 class="fw-bold text-muted mb-3">No characters found</h3>
                <p class="text-muted fs-5 mb-4">You haven't created any heroes yet. Time to start your journey!</p>
                <a asp-controller="Character" asp-action="Create" class="btn btn-outline-blame rounded-pill px-5 py-2 fw-bold">
                    Create your first character
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var character in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden position-relative card-hover" style="background: #ffffff; border: 1px solid #eaeaea !important;">
                        

                        <div class="position-absolute top-0 start-0 w-100 p-3 d-flex justify-content-between align-items-start z-1">
                            <span class="badge rounded-pill" style="background-color: rgba(174, 26, 103, 0.1); color: var(--blame-main); border: 1px solid rgba(174, 26, 103, 0.2); font-size: 0.85rem;">
                                Lvl @character.Level
                            </span>
                            

                            <span class="badge bg-dark rounded-pill shadow-sm" style="font-size: 0.85rem; text-transform: capitalize;">
                                @(character.Class?.ClassName?.Replace("_", " ") ?? "Unknown Class")
                            </span>
                        </div>

                        <div class="card-body pt-5 text-center position-relative z-1 d-flex flex-column">
                            <div class="mb-3 mt-2">

                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light shadow-sm" style="width: 80px; height: 80px; border: 3px solid #fff;">
                                    <i class="bi bi-person-fill text-secondary" style="font-size: 3rem;"></i>
                                </div>
                            </div>
                            
                            <h4 class="fw-bold mb-1" style="color: var(--blame-side-dark);">@character.Name</h4>
                            <p class="text-muted small fw-semibold mb-3" style="text-transform: capitalize;">
                                @(character.Race?.RaceName?.Replace("_", " ") ?? "Unknown Race") &bull; @(string.IsNullOrEmpty(character.Alignment) ? "Neutral" : character.Alignment)
                            </p>


                            <div class="row g-2 mb-4 mt-auto">
                                <div class="col-6">
                                    <div class="bg-light rounded-3 p-2 border h-100 d-flex flex-column justify-content-center">
                                        <div class="small text-muted fw-bold mb-1" style="font-size: 0.7rem; text-transform: uppercase;">Hit Points</div>
                                        <div class="fw-bold fs-5" style="color: #198754;">
                                            <i class="bi bi-heart-fill me-1 fs-6"></i>@character.CurrentHitPoints / @character.MaxHitPoints
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light rounded-3 p-2 border h-100 d-flex flex-column justify-content-center">
                                        <div class="small text-muted fw-bold mb-1" style="font-size: 0.7rem; text-transform: uppercase;">Armor Class</div>
                                        <div class="fw-bold fs-5" style="color: #0dcaf0;">
                                            <i class="bi bi-shield-fill me-1 fs-6"></i>@character.ArmorClass
                                        </div>
                                    </div>
                                </div>
                            </div>
                            

                            <div class="text-start mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted fw-bold" style="font-size: 0.7rem; text-transform: uppercase;">Experience</small>
                                    <small class="text-muted fw-bold">@character.Xp XP</small>
                                </div>
                                <div class="progress rounded-pill bg-light border" style="height: 8px;">
                                    <div class="progress-bar" role="progressbar" style="width: 100%; background: var(--blame-gradient); opacity: 0.8;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 p-3 pt-0">
                            <div class="d-flex gap-2">
                                <a asp-controller="Character" asp-action="Details" asp-route-id="@character.Id" class="btn btn-outline-blame flex-grow-1 rounded-pill fw-bold btn-sm py-2">
                                    <i class="bi bi-eye-fill me-1"></i> Details
                                </a>
                                <a asp-controller="Character" asp-action="Edit" asp-route-id="@character.Id" class="btn btn-outline-secondary flex-grow-1 rounded-pill fw-bold btn-sm py-2">
                                    <i class="bi bi-pencil-fill me-1"></i> Edit
                                </a>
                                <form asp-controller="Character" asp-action="Delete" method="post" class="d-inline m-0" style="flex-shrink: 0;">
                                    <input type="hidden" name="id" value="@character.Id" />
                                    <button type="submit" class="btn btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="return confirm('Do you want to delete this character?');" title="Delete Character">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>