@model large_fantasy_model.ViewModels.ChangePasswordViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Change Password</h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="ChangePassword" method="post">
                        
                        <div class="mb-4">
                            <label asp-for="CurrentPassword" class="form-label fw-bold">Current Password</label>
                            <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Enter your current password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-4 text-muted" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold">New Password</label>
                            <input asp-for="NewPassword" class="form-control" type="password" placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text">Must be at least 8 characters with 1 uppercase, 1 lowercase, and 1 number.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold">Confirm New Password</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Repeat new password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="ProfilePage" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-danger px-4 shadow-sm">Update Password</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@* Skrypty do walidacji w locie (żeby formularz krzyczał bez przeładowania strony) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}