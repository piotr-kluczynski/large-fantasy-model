@model large_fantasy_model.ViewModels.ChangeEmailViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-secondary text-white">
                    <h4 class="mb-0">✉️ Change Email Address</h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="ChangeEmail" method="post">
                        
                        <div class="mb-4">
                            <label asp-for="NewEmail" class="form-label fw-bold">New Email Address</label>
                            <input asp-for="NewEmail" class="form-control" type="email" placeholder="e.g., traveler@tavern.com" />
                            <span asp-validation-for="NewEmail" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-warning border-warning border-opacity-50 py-2 px-3 mb-4" role="alert">
                            <small>To save these changes and secure your account, please verify your identity.</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CurrentPassword" class="form-label fw-bold">Current Password</label>
                            <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Enter your password to confirm" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="ProfilePage" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-secondary px-4 shadow-sm">Update Email</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}