@model large_fantasy_model.Models.User

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-lg border-0 overflow-hidden">
                
                <div class="bg-dark text-white text-center pt-5 pb-4">
                    <img src="https://ui-avatars.com/api/?name=@Model.Username&size=120&background=random" class="rounded-circle img-thumbnail shadow" alt="Avatar">
                    
                    <h2 class="fw-bold mt-3 mb-2">@@@Model.Username</h2>
                    
                    <span class="badge bg-primary fs-6 shadow-sm">Member since: @Model.CreatedDate.ToString("MMMM yyyy")</span>
                </div>

                <div class="card-body bg-light p-4 p-md-5">
                    <div class="row">
                        <div class="col-md-5 border-end pe-4 mb-4 mb-md-0">
                            <h4 class="fw-bold mb-4 border-bottom pb-2 text-dark">Identity</h4>
                            
                            <p class="mb-3">
                                <strong class="text-muted d-block ">Full Name:</strong>
                                <span class="fs-5 text-dark small">@Model.FirstName @Model.LastName</span>
                            </p>
                            
                            <p class="mb-0">
                                <strong class="text-muted d-block ">Email Address:</strong>
                                <span class="fs-5 text-dark small">@Model.Email</span>
                            </p>
                        </div>

                        <div class="col-md-7 ps-md-4">
                            <h4 class="fw-bold mb-4 border-bottom pb-2 text-dark">Biography</h4>
                            
                            <div class="fst-italic text-dark" style="line-height: 1.7;">
                                @if (string.IsNullOrEmpty(Model.Bio))
                                {
                                    <span class="text-muted">This traveler hasn't shared their story yet...</span>
                                }
                                else
                                {
                                    @Model.Bio
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-4 border-top d-flex justify-content-between align-items-center">
                    <div>
                        <a asp-action="ChangeEmail" class="btn btn-outline-secondary btn-sm me-2 shadow-sm">Change Email</a>
                        <a asp-action="ChangePassword" class="btn btn-outline-danger btn-sm shadow-sm">Change Password</a>
                    </div>
                    <a asp-action="Edit" class="btn btn-primary px-4 shadow-sm">Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>