@model IEnumerable<large_fantasy_model.Models.Conversation>
@{
    ViewData["Title"] = "My Messages";
    var myId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value);
    var activeChat = ViewBag.ActiveChat as large_fantasy_model.Models.Conversation;
}
<style>
body {
}
hover-bg:hover {
    background-color: #f8f9fa !important;
    transition: 0.2s;
}

.unread-pop {
    transform: scale(1.02) translateX(5px);
    box-shadow: -4px 4px 15px rgba(0, 0, 0, 0.08) !important;
    border-radius: 8px !important;
    z-index: 10;
    position: relative;
    transition: all 0.3s ease-in-out;
}

</style>
<div class="container mt-4">
    <div class="row" style="height: 75vh;">
        
        
        <div class="col-md-4 h-100">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-chat-dots text-primary me-2"></i> Messages</h5>
                </div>
                <div class="card-body p-0 overflow-auto">
                    <ul class="list-group list-group-flush">
                        @foreach (var chat in Model)
                        {
                            var otherUser = chat.Users.FirstOrDefault(u => u.Id != myId);
                            if (otherUser == null) continue;

                            bool isActive = ViewBag.ActiveConversationId == chat.Id;
    
                            
                            int unreadCount = ViewBag.UnreadCounts != null && ViewBag.UnreadCounts.ContainsKey(chat.Id) ? ViewBag.UnreadCounts[chat.Id] : 0;
                            bool hasUnread = unreadCount > 0;

                            
                            string itemClass = isActive ? "bg-light border-0 border-bottom border-3 border-primary" 
                                                        : (hasUnread ? "bg-white border-0 border-bottom border-3 border-warning fw-bold unread-pop" : "bg-white border-0 border-bottom");

                            <a asp-action="Index" asp-route-conversationId="@chat.Id" class="text-decoration-none">
                                <li id="conv-box-@chat.Id" class="list-group-item d-flex justify-content-between align-items-center py-3 @itemClass hover-bg">
                                    <div class="d-flex align-items-center">
                                        <img src="https://ui-avatars.com/api/?name=@otherUser.Username&size=40&background=random" class="rounded-circle me-3 shadow-sm" />
                                        <div class="text-dark">@otherUser.Username</div>
                                    </div>
            
                                    
                                    <span id="unread-badge-@chat.Id" class="badge bg-danger rounded-pill @(hasUnread && !isActive ? "" : "d-none")">@unreadCount</span>
                                </li>
                            </a>
                        }
                    </ul>
                    @if (!Model.Any())
                    {
                        <p class="text-muted text-center py-4">No active conversations. Go to your friends list to start chatting!</p>
                    }
                </div>
            </div>
        </div>

        
        <div class="col-md-8 h-100">
            @if (activeChat != null)
            {
                var otherUser = activeChat.Users.FirstOrDefault(u => u.Id != myId);

                <div class="card h-100 shadow-sm border-0 rounded-4 d-flex flex-column">
                    
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                        <img src="https://ui-avatars.com/api/?name=@otherUser?.Username&size=40&background=random" class="rounded-circle me-3 shadow-sm" />
                        <h5 class="fw-bold mb-0">@otherUser?.Username</h5>
                    </div>

                    
                    <div class="card-body overflow-auto bg-light p-4" id="chat-messages-box" style="flex-grow: 1;">
                        @if (activeChat.Messages != null && activeChat.Messages.Any())
                        {
                            foreach (var msg in activeChat.Messages.OrderBy(m => m.SendingTime))
                            {
                                bool isMine = msg.UserId == myId;
                                <div class="mb-3 d-flex @(isMine ? "justify-content-end" : "justify-content-start")">
                                    <div class="px-3 py-2 rounded-4 shadow-sm @(isMine ? "bg-primary text-white" : "bg-white text-dark")" style="max-width: 75%;">
                                        <div>@msg.Content</div>
                                        <small class="@(isMine ? "text-light" : "text-muted")" style="font-size: 0.7rem;">@msg.SendingTime.ToString("HH:mm")</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted mt-5">Say hello to @otherUser?.Username!</div>
                        }
                    </div>

                    <div class="card-footer bg-white border-top p-3">
                        <form asp-action="SendMessage" method="post" class="d-flex" id="chat-form">
                            <input type="hidden" name="conversationId" value="@activeChat.Id" />
                            <input type="text" name="content" class="form-control rounded-pill me-2 px-4" id="chat-input" placeholder="Type a message..." required autocomplete="off" />
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Send</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card h-100 shadow-sm border-0 rounded-4 d-flex justify-content-center align-items-center bg-light">
                    <div class="text-center text-muted">
                        <i class="bi bi-chat-square-text fs-1 mb-3 d-block"></i>
                        <h5>Select a conversation to start chatting</h5>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const myUserId = @myId;
    const activeConversationId = "@(activeChat?.Id.ToString() ?? "")";

    
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/privateMessageHub")
    .build();

    
    connection.on("ReceiveMessage", function (convId, content, time, senderId) {
    const isMine = (senderId === myUserId);
        
    
    if (convId.toString() === activeConversationId) {
    const chatBox = document.getElementById("chat-messages-box");
    if (chatBox) {
    const messageHtml = `
    <div class="mb-3 d-flex ${isMine ? 'justify-content-end' : 'justify-content-start'}">
    <div class="px-3 py-2 rounded-4 shadow-sm ${isMine ? 'bg-primary text-white' : 'bg-white text-dark'}" style="max-width: 75%;">
    <div>${content}</div>
    <small class="${isMine ? 'text-light' : 'text-muted'}" style="font-size: 0.7rem;">${time}</small>
    </div>
    </div>
    `;
    chatBox.innerHTML += messageHtml;
    chatBox.scrollTop = chatBox.scrollHeight;
    }
    }
    
    else if (!isMine) {
    const convBox = document.getElementById("conv-box-" + convId);
    const badge = document.getElementById("unread-badge-" + convId);

    if (convBox && badge) {
    
    convBox.classList.add("border-0", "border-bottom", "border-3", "border-warning", "fw-bold", "unread-pop");                
    
    badge.classList.remove("d-none");
    let currentCount = parseInt(badge.innerText) || 0;
    badge.innerText = currentCount + 1;
    }
    }
    });

    
    connection.start().then(function () {
    connection.invoke("JoinMyUserGroup", myUserId.toString());
        
    
    const chatBox = document.getElementById("chat-messages-box");
    if(chatBox) chatBox.scrollTop = chatBox.scrollHeight;
    }).catch(function (err) {
    console.error(err.toString());
    });

    
    const chatForm = document.getElementById("chat-form");
    if(chatForm) {
    chatForm.addEventListener("submit", function (e) {
    e.preventDefault();
    const input = document.getElementById("chat-input");
    const content = input.value;
    if(!content.trim()) return;

    const formData = new FormData(chatForm);
    fetch(chatForm.action, {
    method: 'POST',
    body: formData
    }).then(response => {
    if(response.ok) {
    input.value = "";
    }
    }).catch(error => console.error('Error:', error));
    });
    }
</script>
}