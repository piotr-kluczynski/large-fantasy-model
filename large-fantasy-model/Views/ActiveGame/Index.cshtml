@model large_fantasy_model.ViewModels.GameLobbyViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name - Virtual Tabletop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
            body, html {
                margin: 0;
                padding: 0;
                height: 100%;
                overflow: hidden;
                background-color: #1a1a1a;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            #vtt-board {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: radial-gradient(circle, #2a2a2a, #111);
            }

            #right-sidebar {
                position: absolute;
                top: 0;
                right: -400px;
                width: 400px;
                height: 100%;
                background-color: #2b2b2b;
                color: white;
                box-shadow: -5px 0 15px rgba(0,0,0,0.5);
                transition: right 0.3s ease-in-out;
                display: flex;
                flex-direction: column;
                z-index: 1000;
            }

                #right-sidebar.open {
                    right: 0;
                }

            #toggle-sidebar-btn {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                left: -50px;
                width: 50px;
                height: 50px;
                background-color: #2b2b2b;
                color: white;
                border: none;
                border-radius: 10px 0 0 10px;
                cursor: pointer;
                box-shadow: -5px 0 10px rgba(0,0,0,0.3);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                transition: background 0.2s;
            }
        
                #toggle-sidebar-btn:hover {
                    background-color: #3b3b3b;
                }

            .sidebar-tabs {
                display: flex;
                border-bottom: 1px solid #444;
            }

                .sidebar-tabs button {
                    flex: 1;
                    padding: 15px;
                    background: none;
                    border: none;
                    color: gray;
                    cursor: pointer;
                    font-weight: bold;
                }

                    .sidebar-tabs button.active {
                        color: white;
                        border-bottom: 3px solid #0d6efd;
                    }

            .sidebar-content {
                flex: 1;
                padding: 15px;
                display: none;
                flex-direction: column;
                overflow: hidden;
            }

                .sidebar-content.active {
                    display: flex;
                }

            #players-container {
                position: absolute;
                bottom: 20px;
                left: 20px;
                display: flex;
                gap: 15px;
                z-index: 500;
            }

            .player-avatar {
                width: 60px;
                height: 60px;
                background-color: #333;
                border: 2px solid #555;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: bold;
                font-size: 14px;
                box-shadow: 0 4px 8px rgba(0,0,0,0.4);
                position: relative;
                filter: grayscale(100%);
                transition: filter 0.3s, border-color 0.3s;
            }

                .player-avatar.online {
                    filter: grayscale(0%);
                    border-color: #28a745;
                }

                .player-avatar.dm-avatar {
                    border-color: #ffc107;
                }
        
            .status-indicator {
                position: absolute;
                bottom: 2px;
                right: 2px;
                width: 12px;
                height: 12px;
                background-color: #6c757d;
                border: 2px solid #1a1a1a;
                border-radius: 50%;
            }

            .online .status-indicator {
                background-color: #28a745;
            }

            #exit-vtt {
                position: absolute;
                top: 20px;
                left: 20px;
                z-index: 500;
            }
    </style>
</head>
<body>

    <a id="exit-vtt" class="btn btn-danger d-flex align-items-center" asp-controller="Game" asp-action="LobbyDetails" asp-route-id="@Model.GameId">
        <div class="d-flex justify-content-center flex-shrink-0 me-2" style="width: 24px;">
            <i class="bi bi-box-arrow-left fs-5 mt-0"></i>
        </div>
        <span class="fw-bold">Exit to Lobby</span>
    </a>

    <div id="vtt-board"></div>

    <div id="players-container">
        <div class="player-avatar dm-avatar" id="player-@Model.DungeonMaster.Id" title="DM: @Model.DungeonMaster.Username">
            @Model.DungeonMaster.Username.Substring(0, Math.Min(3, Model.DungeonMaster.Username.Length)).ToUpper()
            <div class="status-indicator"></div>
        </div>

        @foreach (var player in Model.Players)
        {
            <div class="player-avatar" id="player-@player.Id" title="@player.Username">
                @player.Username.Substring(0, Math.Min(3, player.Username.Length)).ToUpper()
                <div class="status-indicator"></div>
            </div>
        }
    </div>

    <div id="right-sidebar">
        <button id="toggle-sidebar-btn">
            <i class="bi bi-chat-left-dots"></i>
        </button>

        <div class="sidebar-tabs">
            <button id="tab-chat" class="active" onclick="switchTab('chat')">Chat</button>
            <button id="tab-tools" onclick="switchTab('tools')">Tools</button>
        </div>

        <div id="content-chat" class="sidebar-content active">
            <h5 class="mb-3">Game Chat</h5>
            <div class="chat-messages flex-grow-1" style="background: #1f1f1f; border-radius: 5px; padding: 10px; overflow-y: auto; margin-bottom: 15px;">
                <p class="text-muted small">Welcome to the session!</p>
            </div>
            <div class="input-group mt-auto">
                <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Type a message...">
                <button class="btn btn-primary" type="button"><i class="bi bi-send"></i></button>
            </div>
        </div>

        <div id="content-tools" class="sidebar-content">
            <h5>Tools</h5>
            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-outline-light"><i class="bi bi-dice-6"></i> Roll Dice</button>
                <button class="btn btn-outline-light"><i class="bi bi-person-vcard"></i> Character Sheet</button>
                <button class="btn btn-outline-light"><i class="bi bi-journal-text"></i> Notes</button>
                
                @if (Model.IsDungeonMaster)
                {
                    <hr class="border-secondary" />
                    <button class="btn btn-outline-warning"><i class="bi bi-map"></i> Change Map</button>
                    <button class="btn btn-outline-danger"><i class="bi bi-robot"></i> AI Assistant (LLM)</button>
                }
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>

        const sidebar = document.getElementById('right-sidebar');
        const toggleBtn = document.getElementById('toggle-sidebar-btn');
        const toggleIcon = toggleBtn.querySelector('i');

        toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        if (sidebar.classList.contains('open')) {
        toggleIcon.classList.replace('bi-chat-left-dots', 'bi-chevron-right');
        } else {
        toggleIcon.classList.replace('bi-chevron-right', 'bi-chat-left-dots');
        }
        });

        function switchTab(tabName) {
        document.querySelectorAll('.sidebar-tabs button').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.sidebar-content').forEach(c => c.classList.remove('active'));
        document.getElementById('tab-' + tabName).classList.add('active');
        document.getElementById('content-' + tabName).classList.add('active');
        }

   
        const gameId = @Model.GameId;
        const currentUserId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";
        const myUsername = "@User.Identity.Name";
        
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/gameHub")
        .build();


        connection.on("UserStatusChanged", (userId, isOnline, username) => {
        const avatar = document.getElementById("player-" + userId);
        if (avatar) {
        if (isOnline) {
        avatar.classList.add("online");
        } else {
        avatar.classList.remove("online");
        }
        }
        });

        connection.on("RequestStatusSync", () => {
        connection.invoke("ReportStatus", gameId, currentUserId)
        .catch(err => console.error(err.toString()));
        });


        const chatInput = document.querySelector('#content-chat input');
        const sendBtn = document.querySelector('#content-chat button');
        const chatBox = document.querySelector('.chat-messages');

        connection.on("ReceiveGameMessage", (username, message, time) => {
        const isMe = username === myUsername;
            
        const msgWrapper = document.createElement('div');
        msgWrapper.className = "d-flex w-100 mb-2";
        msgWrapper.style.justifyContent = isMe ? "flex-end" : "flex-start";

        const msgBubble = document.createElement('div');
        msgBubble.style.maxWidth = "80%";
        msgBubble.style.padding = "8px 12px";
        msgBubble.style.borderRadius = "10px";
        msgBubble.style.wordWrap = "break-word";

        if (isMe) {
        msgBubble.style.backgroundColor = "#0d6efd";
        msgBubble.style.color = "white";
        msgBubble.innerHTML = `<div class="d-flex justify-content-between align-items-baseline mb-1"><strong class="small me-3">Me</strong> <span class="text-light opacity-75" style="font-size: 0.65rem;">${time}</span></div><div>${message}</div>`;
        } else {
        msgBubble.style.backgroundColor = "#333333";
        msgBubble.style.color = "white";
        msgBubble.innerHTML = `<div class="d-flex justify-content-between align-items-baseline mb-1"><strong class="text-warning small me-3">${username}</strong> <span class="text-muted" style="font-size: 0.65rem;">${time}</span></div><div>${message}</div>`;
        }

        msgWrapper.appendChild(msgBubble);
        chatBox.appendChild(msgWrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
        });


        function sendMessage() {
        const message = chatInput.value;
        if (message.trim() !== "") {
        connection.invoke("SendMessageToGame", gameId, myUsername, message)
        .catch(err => console.error(err.toString()));
        chatInput.value = "";
        }
        }

        sendBtn.addEventListener("click", sendMessage);
        chatInput.addEventListener("keypress", (e) => { if (e.key === 'Enter') sendMessage(); });


        connection.start().then(() => {
        connection.invoke("JoinGameSession", gameId, myUsername);
        const myAvatar = document.getElementById("player-" + currentUserId);
        if (myAvatar) myAvatar.classList.add("online");
        }).catch(err => console.error(err.toString()));

        document.getElementById("exit-vtt").addEventListener("click", () => {
        connection.invoke("LeaveGameSession", gameId);
        });
    </script>
</body>
</html>