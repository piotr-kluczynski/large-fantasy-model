@model large_fantasy_model.ViewModels.ActiveGameViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@{
    Layout = null;

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name - Virtual Tabletop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/vtt.css" />
   
</head>
<body data-game-id="@Model.GameId" 
      data-current-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" 
      data-my-username="@User.Identity.Name" 
      data-is-dm="@(Model.IsDungeonMaster ? "true" : "false")" 
      data-initial-map-url="@Model.MapImageUrl">

    <a id="exit-vtt" class="btn btn-danger d-flex align-items-center shadow" asp-controller="Game" asp-action="LobbyDetails" asp-route-id="@Model.GameId">
        <div class="d-flex justify-content-center flex-shrink-0 me-2" style="width: 24px;"><i class="bi bi-box-arrow-left fs-5 mt-0"></i></div>
        <span class="fw-bold">Exit to Lobby</span>
    </a>

    <div id="viewport">
        <div id="map-container">
            @foreach (var token in Model.Tokens)
            {
                int hpPercent = token.MaxHp > 0 ? (token.CurrentHp * 100) / token.MaxHp : 0;
                string hpColor = hpPercent > 50 ? "#28a745" : (hpPercent > 20 ? "#ffc107" : "#dc3545");

                <div class="game-token d-flex justify-content-center align-items-center fw-bold" 
                     id="token-@token.Id" data-token-id="@token.Id" data-owner-id="@token.UserId" data-token-name="@token.Name"
                     data-current-hp="@token.CurrentHp" data-max-hp="@token.MaxHp"
                     style="left: @(token.X)px; top: @(token.Y)px; background-color: @token.Color;">
                    <div class="token-hp-container">
                        <div class="token-hp-fill" style="width: @(hpPercent)%; background-color: @hpColor;"></div>
                    </div>
                    @(token.Name.Substring(0, Math.Min(2, token.Name.Length)).ToUpper())
                </div>
            }
        </div>
    </div>

    <div id="players-container">
        <div class="player-avatar dm-avatar" id="player-@Model.DungeonMaster.Id" title="DM: @Model.DungeonMaster.Username" style="background-image: url('@AvatarHelper.GetUserAvatar(Model.DungeonMaster.Username, Model.DungeonMaster.ProfilePicturePath, _env.WebRootPath, 50)'); background-size: cover; background-position: center;">
            <div class="status-indicator"></div>
        </div>
        @foreach (var player in Model.Players)
        {
            <div class="player-avatar" id="player-@player.Id" title="@player.Username" style="background-image: url('@AvatarHelper.GetUserAvatar(player.Username, player.ProfilePicturePath, _env.WebRootPath, 50)'); background-size: cover; background-position: center;">
                <div class="status-indicator"></div>
            </div>
        }
    </div>

    <div id="right-sidebar">
        <button id="toggle-sidebar-btn" title="Toggle Chat"><i class="bi bi-chat-left-dots"></i></button>
        
        <div class="sidebar-tabs">
            <button id="tab-chat" class="active" onclick="switchTab('chat')">Chat</button>
            <button id="tab-tools" onclick="switchTab('tools')">Tools</button>
        </div>
        
        <div id="content-chat" class="sidebar-content active">
            <h5 class="mb-3">Game Chat</h5>
            <div class="chat-messages flex-grow-1" style="background: #1f1f1f; border-radius: 5px; padding: 10px; overflow-y: auto; margin-bottom: 15px;">
                <p class="text-muted small text-center mb-3">--- Welcome to the session ---</p>
                @foreach (var msg in Model.ChatMessages)
                {
                    bool isMe = msg.SenderName == User.Identity.Name;
                    bool isDice = msg.Text.StartsWith("[DICE]");
                    bool isSystem = msg.Text.StartsWith("[SYSTEM]");
                    string cleanText = msg.Text.Replace("[DICE]", "").Replace("[SYSTEM]", "").Trim();

                    if (isSystem) {
                        <div class="d-flex w-100 mb-2 justify-content-center"><div class="w-100 text-center py-2 px-3 rounded shadow-sm" style="background-color: #242424; border: 1px solid #444; max-width: 95%;"><div class="text-muted mb-1" style="font-size: 0.65rem;">@msg.Time</div><div class="fst-italic text-light opacity-75" style="font-size: 0.85rem;">@cleanText</div></div></div>
                    } else if (isDice) {
                        <div class="d-flex w-100 mb-2 justify-content-center"><div class="w-100 border border-warning text-center p-2 rounded-3 bg-dark text-warning" style="max-width: 90%; font-size: 0.9rem; box-shadow: 0 0 10px rgba(255,193,7,0.2);"><div class="text-muted mb-1" style="font-size: 0.7rem;">@msg.Time - <strong style="color: #ffc107;">@(isMe ? "You" : msg.SenderName)</strong> rolled:</div><div class="fw-bold fs-5">@cleanText</div></div></div>
                    } else {
                        <div class="d-flex w-100 mb-2" style="justify-content: @(isMe ? "flex-end" : "flex-start")"><div style="max-width: 80%; padding: 8px 12px; border-radius: 10px; word-wrap: break-word; background-color: @(isMe ? "#0d6efd" : "#333333"); color: white;"><div class="d-flex justify-content-between align-items-baseline mb-1"><strong class="@(isMe ? "" : "text-warning") small me-3">@(isMe ? "Me" : msg.SenderName)</strong><span class="@(isMe ? "text-light opacity-75" : "text-muted")" style="font-size: 0.65rem;">@msg.Time</span></div><div>@cleanText</div></div></div>
                    }
                }
            </div>
            <div class="input-group mt-auto">
                <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Type a message...">
                <button class="btn btn-primary" type="button"><i class="bi bi-send"></i></button>
            </div>
        </div>
        
        <div id="content-tools" class="sidebar-content text-center">
            <h5>Player Tools</h5>
            <div class="d-grid gap-2 mt-2">
                <div class="dropdown d-grid">
                    <button class="btn btn-outline-light dropdown-toggle" type="button" id="diceDropdown" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-dice-6 me-2"></i> Roll Dice</button>
                    <ul class="dropdown-menu dropdown-menu-dark w-100 shadow" aria-labelledby="diceDropdown">
                        <li><button class="dropdown-item dice-btn" data-sides="4">D4 (Triangle)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="6">D6 (Standard Cube)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="8">D8 (Octahedron)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="10">D10 (Pentagonal Trapezohedron)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="12">D12 (Dodecahedron)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="20"><strong>D20 (Core D&D)</strong></button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item dice-btn" data-sides="100">D100 (Percentile)</button></li>
                    </ul>
                </div>
                <button class="btn btn-outline-light btn-open-sheet"><i class="bi bi-person-vcard"></i> Character Sheet</button>
                <button id="btn-open-notes" class="btn btn-outline-light"><i class="bi bi-journal-text"></i> Notes</button>
                
                @if (Model.IsDungeonMaster)
                {
                    <div class="mt-4 pt-3 border-top border-secondary">
                        <h5 class="text-center text-warning mb-3"> DM Tools</h5>
                        <div class="d-grid gap-2">
                            <button id="btn-change-map" class="btn btn-outline-warning"><i class="bi bi-map"></i> Change Map</button>
                            <button id="btn-open-ai" class="btn btn-outline-warning"><i class="bi bi-robot"></i> AI Assistant (LLM)</button>
                            <button id="btn-long-rest" class="btn btn-outline-warning"><i class="bi bi-moon-stars"></i> Long Rest (Heal All)</button>
                            <button id="btn-global-hp" class="btn btn-outline-warning"><i class="bi bi-heart"></i> Set Global Max HP</button>
                            <button id="btn-spawn-monster" class="btn btn-outline-warning fw-bold"><i class="bi bi-bug-fill"></i> Spawn Monster</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="combat-panel">
        <button id="toggle-combat-btn" title="Toggle Initiative Tracker"><i class="bi bi-hammer"></i></button>
        <div class="bg-dark border-bottom border-secondary p-3 d-flex justify-content-between align-items-center" style="border-top-right-radius: 10px;">
            <h5 class="mb-0 text-warning fw-bold"><i class="bi bi-swords me-2"></i> Initiative Tracker</h5>
            <button type="button" class="btn-close btn-close-white" id="close-combat-btn"></button>
        </div>
        
        <div class="p-3 d-flex flex-column h-100">
            @if (Model.IsDungeonMaster)
            {
                <div class="mb-3 border-bottom border-secondary pb-3">
                    <div class="d-flex justify-content-between gap-1 mb-2">
                        <button id="btn-refresh-combat" class="btn btn-sm btn-outline-info w-100" title="Load all tokens from map"><i class="bi bi-arrow-clockwise"></i> Load</button>
                        <button id="btn-sort-combat" class="btn btn-sm btn-outline-warning w-100" title="Sort by highest value"><i class="bi bi-sort-numeric-down-alt"></i> Sort</button>
                        <button id="btn-next-turn" class="btn btn-sm btn-success fw-bold w-100"><i class="bi bi-play-fill"></i> Next</button>
                    </div>
                    <div class="d-flex justify-content-between gap-1">
                        <div class="dropdown w-100">
                            <button class="btn btn-sm btn-outline-primary w-100 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-dice-5-fill"></i> Roll Monsters
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark shadow" style="min-width: 100px;">
                                <li><button class="dropdown-item autoroll-btn py-1" data-sides="4">D4</button></li>
                                <li><button class="dropdown-item autoroll-btn py-1" data-sides="6">D6</button></li>
                                <li><button class="dropdown-item autoroll-btn py-1" data-sides="8">D8</button></li>
                                <li><button class="dropdown-item autoroll-btn py-1" data-sides="10">D10</button></li>
                                <li><button class="dropdown-item autoroll-btn py-1" data-sides="12">D12</button></li>
                                <li><button class="dropdown-item autoroll-btn py-1 text-warning fw-bold" data-sides="20">D20</button></li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li><button class="dropdown-item autoroll-btn py-1" data-sides="100">D100</button></li>
                            </ul>
                        </div>
                        <button id="btn-clear-combat" class="btn btn-sm btn-outline-danger w-100" title="Clear all from combat"><i class="bi bi-trash3-fill"></i> Clear All</button>
                    </div>
                </div>
            }
            <div id="initiative-list" class="flex-grow-1" style="overflow-y: auto;">
                <p class="text-muted small text-center mt-4">No active combat. DM can load tokens.</p>
            </div>
        </div>
    </div>

    @if (Model.IsDungeonMaster)
    {
        <div class="modal fade" id="mapGalleryModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
              <div class="modal-header border-secondary"><h5 class="modal-title">Select Battlemap</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
              <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-4"><div class="card bg-secondary text-white map-option" data-url="/maps/grass.png" style="cursor: pointer; transition: 0.2s;"><div class="card-body text-center p-4"><i class="bi bi-tree-fill fs-1 mb-2 text-success"></i><h6>Grass Plains</h6></div></div></div>
                    <div class="col-md-4"><div class="card bg-secondary text-white map-option" data-url="/maps/tavern.png" style="cursor: pointer; transition: 0.2s;"><div class="card-body text-center p-4"><i class="bi bi-house-door-fill fs-1 mb-2 text-warning"></i><h6>Tavern</h6></div></div></div>
                    <div class="col-md-4"><div class="card bg-secondary text-white map-option" data-url="/maps/dungeon.png" style="cursor: pointer; transition: 0.2s;"><div class="card-body text-center p-4"><i class="bi bi-bricks fs-1 mb-2 text-danger"></i><h6>Dungeon</h6></div></div></div>
                    <div class="col-md-12 mt-4"><button class="btn btn-outline-danger w-100 map-option" data-url=""><i class="bi bi-x-circle me-2"></i> Clear Map (Grid only)</button></div>
                </div>
              </div>
            </div>
          </div>
        </div>
    }

    <div class="modal fade" id="spawnMonsterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-dark text-white border-danger shadow-lg">
                <div class="modal-header border-danger" style="background: linear-gradient(135deg, #4a0000 0%, #1a1a1a 100%);">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-bug-fill me-2"></i> Spawn Monster</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3"><label class="form-label text-muted small fw-bold">NAME (e.g. Goblin)</label><input type="text" id="monster-name" class="form-control bg-dark text-white border-secondary fw-bold" value="Goblin"></div>
                    <div class="row">
                        <div class="col-6"><label class="form-label text-muted small fw-bold">MAX HP</label><input type="number" id="monster-hp" class="form-control bg-dark text-white border-secondary text-center fw-bold" value="15"></div>
                        <div class="col-6"><label class="form-label text-muted small fw-bold">COLOR</label><input type="color" id="monster-color" class="form-control form-control-color w-100 bg-dark border-secondary p-1" value="#dc3545"></div>
                    </div>
                </div>
                <div class="modal-footer border-secondary p-2"><button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="btn-confirm-spawn" class="btn btn-sm btn-danger fw-bold px-4">Spawn on Map</button></div>
            </div>
        </div>
    </div>

    <div id="token-context-menu" class="card shadow-lg border-secondary" style="display: none; position: absolute; z-index: 2000; width: 250px; border-radius: 12px; overflow: hidden; background-color: #1e1e1e; color: #e0e0e0;">
        <div class="card-header border-secondary py-2 px-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #333 0%, #1a1a1a 100%);">
            <div class="d-flex flex-column"><span class="small fw-bold text-warning">Edit <span id="ctx-token-name">Token</span></span><span class="badge bg-secondary text-light mt-1" style="font-size: 0.65rem; width: fit-content;">Level ? / Class</span></div>
            <button type="button" class="btn-close btn-close-white" style="font-size: 0.6rem;" id="ctx-close"></button>
        </div>
        <div class="card-body p-3">
            <div class="mb-3 d-flex justify-content-between align-items-center"><span class="small fw-bold text-danger"><i class="bi bi-heart-fill me-1"></i> HP:</span>
                <div class="input-group input-group-sm w-75 shadow-sm"><input type="number" id="ctx-current-hp" class="form-control bg-dark text-white border-secondary text-center" value="10"><span class="input-group-text bg-secondary text-white border-secondary px-2">/</span><input type="number" id="ctx-max-hp" class="form-control bg-dark text-white border-secondary text-center" value="10"></div>
            </div>
            <div class="input-group input-group-sm mb-3 shadow-sm"><input type="number" id="ctx-hp-mod" class="form-control bg-dark text-white border-secondary text-center" placeholder="Val..." min="0"><button class="btn btn-danger fw-bold" id="btn-dmg" type="button" title="Damage">- Dmg</button><button class="btn btn-success fw-bold" id="btn-heal" type="button" title="Heal">+ Heal</button></div>
            <hr class="border-secondary my-2">
            <button class="btn btn-warning btn-sm w-100 fw-bold mb-2 shadow-sm" id="btn-save-hp">Set Absolute HP</button>
            <button class="btn btn-primary btn-sm w-100 fw-bold mb-2 shadow-sm btn-open-sheet">Open Character Sheet</button>
            @if (Model.IsDungeonMaster){<button class="btn btn-outline-danger btn-sm w-100 fw-bold shadow-sm" id="btn-delete-token">Delete Token</button>}
        </div>
    </div>

    <div class="modal fade" id="characterSheetModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-person-vcard me-2"></i> Character Sheet</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0" style="height: 80vh;">
                    @if (Model.CurrentUserCharacterId.HasValue)
                    {
                        <iframe src="/Character/Details/@Model.CurrentUserCharacterId?iframe=true" style="width: 100%; height: 100%; border: none;"></iframe>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-exclamation-triangle fs-1 text-warning mb-3"></i>
                            <h5>No character selected.</h5>
                            <p class="text-muted">Return to the lobby to select a character.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="notesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark text-white border-secondary" style="width: 100%; max-width: 800px;">
                <div class="bg-dark text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold" style="color: #e0c968;"><i class="bi bi-journal-text me-2"></i> Personal Notes</h4>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i> These notes are saved locally in your browser.</p>
                    <textarea id="personal-notes-area" class="form-control bg-dark text-white border-secondary w-100" style="height: 400px; resize: none;" placeholder="Write down your quest objectives..."></textarea>
                </div>
                <div class="p-3 border-top border-secondary d-flex justify-content-between align-items-center">
                    <span id="notes-save-status" class="text-success fw-bold ms-2" style="opacity: 0; transition: opacity 0.3s;"><i class="bi bi-check-circle-fill me-1"></i> Saved!</span>
                    <div>
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
                        <button type="button" id="btn-save-notes" class="btn btn-primary fw-bold px-4">Save Notes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="aiModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark text-white border-warning shadow-lg">
            
                <div class="modal-header border-warning" style="background: linear-gradient(135deg, #332b00 0%, #1a1a1a 100%);">
                    <h5 class="modal-title fw-bold text-warning"><i class="bi bi-robot me-2"></i> AI Dungeon Master Assistant</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            
                <div class="modal-body p-0 d-flex flex-column" style="height: 60vh;">
                    <div id="ai-chat-history" class="flex-grow-1 p-3 overflow-auto" style="background-color: #151515;">
                        <div class="text-center text-muted small mb-4">--- Connected to the Gemini model ---</div>
                    
                        <div class="d-flex w-100 mb-3 justify-content-start">
                            <div class="p-2 rounded shadow-sm" style="background-color: #2b2b2b; border: 1px solid #444; max-width: 85%;">
                                <div class="text-warning small fw-bold mb-1"><i class="bi bi-robot"></i> Gemini</div>
                                <div>
                                    Hello, Game Master. What do you want to ask? Do you need an NPC name, a trap description, or monster stats?
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <div class="p-3 border-top border-warning" style="background-color: #1e1e1e;">
                        <div class="input-group shadow-sm">
                            <textarea id="ai-prompt" class="form-control bg-dark text-white border-secondary custom-scrollbar" rows="2" placeholder="Write here... (Enter to send, Shift+Enter new line)" style="resize: none;"></textarea>
                            <button class="btn btn-warning fw-bold px-4" type="button" id="btn-generate-ai" title="Send">
                                <i class="bi bi-send-fill fs-5"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/vtt/Vtt-config.js"></script>
    <script src="~/js/vtt/Vtt-signalr.js"></script>
    <script src="~/js/vtt/Vtt-map.js"></script>
    <script src="~/js/vtt/Vtt-tokens.js"></script>
    <script src="~/js/vtt/Vtt-combat.js"></script>
    <script src="~/js/vtt/Vtt-ai.js"></script>

</body>
</html>