@model large_fantasy_model.ViewModels.ActiveGameViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name - Virtual Tabletop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            background-color: #1a1a1a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
        }

       
        .map-option {
            transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease !important;
            border: 1px solid ;
        }

        .map-option:hover {
            filter: brightness(1.2); 
            transform: translateY(-3px); 
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.6); 
            border: 1px solid #6c757d; 
        }
        #viewport {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            cursor: grab;
            z-index: 1; 
        }

        #viewport:active {
            cursor: grabbing;
        }

        #map-container {
            width: 5000px;
            height: 5000px;
            position: absolute;
            top: 0;
            left: 0;
            transform-origin: 0 0;
            background-color: #2b2b2b;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            will-change: transform;
        }


        .game-token {
            width: 50px;
            height: 50px;
            position: absolute;
            background-color: #333;
            color: white;
            border: 3px solid;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0,0,0,0.6);
            z-index: 10;
            transition: transform 0.1s, box-shadow 0.1s;
        }

        .game-token:hover {
            filter: brightness(1.2);
            z-index: 11;
        }

        .game-token.dragging {
            opacity: 0.8;
            transform: scale(1.1);
            box-shadow: 0 10px 20px rgba(0,0,0,0.8);
            z-index: 100 !important;
            cursor: grabbing;
        }


        #right-sidebar {
            position: absolute;
            top: 0;
            right: -400px;
            width: 400px;
            height: 100%;
            background-color: #2b2b2b;
            color: white;
            box-shadow: -5px 0 15px rgba(0,0,0,0.5);
            transition: right 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        #right-sidebar.open { right: 0; }

        #toggle-sidebar-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: -50px;
            width: 50px;
            height: 50px;
            background-color: #2b2b2b;
            color: white;
            border: none;
            border-radius: 10px 0 0 10px;
            cursor: pointer;
            box-shadow: -5px 0 10px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            transition: background 0.2s;
        }
        
        #toggle-sidebar-btn:hover { background-color: #3b3b3b; }
        .sidebar-tabs { display: flex; border-bottom: 1px solid #444; }
        .sidebar-tabs button { flex: 1; padding: 15px; background: none; border: none; color: gray; cursor: pointer; font-weight: bold; }
        .sidebar-tabs button.active { color: white; border-bottom: 3px solid #0d6efd; }
        .sidebar-content { flex: 1; padding: 15px; display: none; flex-direction: column; overflow: hidden; }
        .sidebar-content.active { display: flex; }
        #players-container { position: absolute; bottom: 20px; left: 20px; display: flex; gap: 15px; z-index: 500; }
        .player-avatar { width: 60px; height: 60px; background-color: #333; border: 2px solid #555; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 14px; box-shadow: 0 4px 8px rgba(0,0,0,0.4); position: relative; filter: grayscale(100%); transition: filter 0.3s, border-color 0.3s; }
        .player-avatar.online { filter: grayscale(0%); border-color: #28a745; }
        .player-avatar.dm-avatar { border-color: #ffc107; }
        .status-indicator { position: absolute; bottom: 2px; right: 2px; width: 12px; height: 12px; background-color: #6c757d; border: 2px solid #1a1a1a; border-radius: 50%; }
        .online .status-indicator { background-color: #28a745; }
        #exit-vtt { position: absolute; top: 20px; left: 20px; z-index: 500; }
    </style>
</head>
<body>

    <a id="exit-vtt" class="btn btn-danger d-flex align-items-center shadow" asp-controller="Game" asp-action="LobbyDetails" asp-route-id="@Model.GameId">
        <div class="d-flex justify-content-center flex-shrink-0 me-2" style="width: 24px;">
            <i class="bi bi-box-arrow-left fs-5 mt-0"></i>
        </div>
        <span class="fw-bold">Exit to Lobby</span>
    </a>

    <div id="viewport">
        <div id="map-container">
            @foreach (var token in Model.Tokens)
            {
                <div class="game-token" 
                     id="token-@token.Id" 
                     data-token-id="@token.Id" 
                     data-owner-id="@token.UserId"
                     style="left: @(token.X)px; top: @(token.Y)px; border-color: @token.Color;"
                     title="@token.Name">
                    @token.Name.Substring(0, Math.Min(2, token.Name.Length)).ToUpper()
                </div>
            }
        </div>
    </div>

    <div id="players-container">
        <div class="player-avatar dm-avatar" id="player-@Model.DungeonMaster.Id" title="DM: @Model.DungeonMaster.Username">
            @Model.DungeonMaster.Username.Substring(0, Math.Min(3, Model.DungeonMaster.Username.Length)).ToUpper()
            <div class="status-indicator"></div>
        </div>
        @foreach (var player in Model.Players)
        {
            <div class="player-avatar" id="player-@player.Id" title="@player.Username">
                @player.Username.Substring(0, Math.Min(3, player.Username.Length)).ToUpper()
                <div class="status-indicator"></div>
            </div>
        }
    </div>

    <div id="right-sidebar">
        <button id="toggle-sidebar-btn"><i class="bi bi-chat-left-dots"></i></button>
        <div class="sidebar-tabs">
            <button id="tab-chat" class="active" onclick="switchTab('chat')">Chat</button>
            <button id="tab-tools" onclick="switchTab('tools')">Tools</button>
        </div>
        <div id="content-chat" class="sidebar-content active">
            <h5 class="mb-3">Game Chat</h5>
            <div class="chat-messages flex-grow-1" style="background: #1f1f1f; border-radius: 5px; padding: 10px; overflow-y: auto; margin-bottom: 15px;">
                <p class="text-muted small text-center mb-3">--- Welcome to the session ---</p>
                
                @foreach (var msg in Model.ChatMessages)
                {
                    bool isMe = msg.SenderName == User.Identity.Name;
                    bool isDice = msg.Text.StartsWith("[DICE]");
                    string cleanText = isDice ? msg.Text.Replace("[DICE]", "") : msg.Text;

                    if (isDice)
                    {
                        <div class="d-flex w-100 mb-2 justify-content-center">
                            <div class="w-100 border border-warning text-center p-2 rounded-3 bg-dark text-warning" style="max-width: 90%; font-size: 0.9rem; box-shadow: 0 0 10px rgba(255,193,7,0.2);">
                                <div class="text-muted" style="font-size: 0.65rem;">@msg.Time - @(isMe ? "You" : msg.SenderName) rolled:</div>
                                <div class="fw-bold">@cleanText</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex w-100 mb-2" style="justify-content: @(isMe ? "flex-end" : "flex-start")">
                            <div style="max-width: 80%; padding: 8px 12px; border-radius: 10px; word-wrap: break-word; background-color: @(isMe ? "#0d6efd" : "#333333"); color: white;">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <strong class="@(isMe ? "" : "text-warning") small me-3">@(isMe ? "Me" : msg.SenderName)</strong> 
                                    <span class="@(isMe ? "text-light opacity-75" : "text-muted")" style="font-size: 0.65rem;">@msg.Time</span>
                                </div>
                                <div>@cleanText</div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="input-group mt-auto">
                <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Type a message...">
                <button class="btn btn-primary" type="button"><i class="bi bi-send"></i></button>
            </div>
        </div>
        <div id="content-tools" class="sidebar-content">
            <h5>Tools</h5>
            <div class="d-grid gap-2 mt-3">
                <div class="dropdown d-grid">
                    <button class="btn btn-outline-light dropdown-toggle" type="button" id="diceDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-dice-6 me-2"></i> Roll Dice
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark w-100 shadow" aria-labelledby="diceDropdown">
                        <li><button class="dropdown-item dice-btn" data-sides="4">D4 (Triangle)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="6">D6 (Standard Cube)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="8">D8 (Octahedron)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="10">D10 (Pentagonal Trapezohedron)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="12">D12 (Dodecahedron)</button></li>
                        <li><button class="dropdown-item dice-btn" data-sides="20"><strong>D20 (Core D&D)</strong></button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item dice-btn" data-sides="100">D100 (Percentile)</button></li>
                    </ul>
                </div>
                <button class="btn btn-outline-light"><i class="bi bi-person-vcard"></i> Character Sheet</button>
                <button class="btn btn-outline-light"><i class="bi bi-journal-text"></i> Notes</button>
                @if (Model.IsDungeonMaster)
                {
                    <hr class="border-secondary" />
                    <button id="btn-change-map" class="btn btn-outline-warning"><i class="bi bi-map"></i> Change Map</button>
                    <button class="btn btn-outline-danger"><i class="bi bi-robot"></i> AI Assistant (LLM)</button>
                }
            </div>
        </div>
    </div>
    @if (Model.IsDungeonMaster)
    {
        <div class="modal fade" id="mapGalleryModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
              <div class="modal-header border-secondary">
                <h5 class="modal-title">Select Battlemap</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card bg-secondary text-white map-option" data-url="/maps/grass.png" style="cursor: pointer; transition: 0.2s;">
                            <div class="card-body text-center p-4">
                                <i class="bi bi-tree-fill fs-1 mb-2 text-success"></i>
                                <h6>Grass Plains</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-secondary text-white map-option" data-url="/maps/tavern.png" style="cursor: pointer; transition: 0.2s;">
                            <div class="card-body text-center p-4">
                                <i class="bi bi-house-door-fill fs-1 mb-2 text-warning"></i>
                                <h6>Tavern</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-secondary text-white map-option" data-url="/maps/dungeon.png" style="cursor: pointer; transition: 0.2s;">
                            <div class="card-body text-center p-4">
                                <i class="bi bi-bricks fs-1 mb-2 text-danger"></i>
                                <h6>Dungeon</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 mt-4">
                        <button class="btn btn-outline-danger w-100 map-option" data-url="">
                            <i class="bi bi-x-circle me-2"></i> Clear Map (Grid only)
                        </button>
                    </div>
                </div>
              </div>
            </div>
          </div>
        </div>
    }
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    const gameId = @Model.GameId;
    const currentUserId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";
    const myUsername = "@User.Identity.Name";
    const isDM = @(Model.IsDungeonMaster ? "true" : "false");

    const viewport = document.getElementById('viewport');
    const mapContainer = document.getElementById('map-container');
    let isMapDragging = false;
    let mapStartX, mapStartY;
    let mapX = -2000; 
    let mapY = -2000;
    let mapScale = 1; 

    function updateMapTransform() {
        mapContainer.style.transform = `translate(${mapX}px, ${mapY}px) scale(${mapScale})`;
    }
    updateMapTransform();

    viewport.addEventListener('mousedown', (e) => {
        if (e.target.closest('.game-token') || e.target.closest('#right-sidebar') || e.target.closest('#players-container') || e.target.closest('#exit-vtt') || e.target.closest('#toggle-sidebar-btn')) return; 
        isMapDragging = true;
        mapStartX = e.clientX - mapX;
        mapStartY = e.clientY - mapY;
    });

    window.addEventListener('mousemove', (e) => {
        if (!isMapDragging) return;
        mapX = e.clientX - mapStartX;
        mapY = e.clientY - mapStartY;
        updateMapTransform();
    });

    window.addEventListener('mouseup', () => { isMapDragging = false; });

    viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomDirection = e.deltaY < 0 ? 1 : -1;
        const oldScale = mapScale;
        mapScale += zoomDirection * 0.1;
        mapScale = Math.min(Math.max(0.2, mapScale), 3.0);
        const mouseMapX = (e.clientX - mapX) / oldScale;
        const mouseMapY = (e.clientY - mapY) / oldScale;
        mapX = e.clientX - (mouseMapX * mapScale);
        mapY = e.clientY - (mouseMapY * mapScale);
        updateMapTransform();
    }, { passive: false }); 

    let activeToken = null;
    let tokenOffsetX = 0;
    let tokenOffsetY = 0;

    document.querySelectorAll('.game-token').forEach(token => {
        token.addEventListener('mousedown', (e) => {
            if (!isDM && token.getAttribute('data-owner-id') !== currentUserId) {
                return; 
            }

            e.stopPropagation(); 
            activeToken = token;
            activeToken.classList.add('dragging');

            activeToken.style.transition = "none";

            const rect = activeToken.getBoundingClientRect();
            tokenOffsetX = (e.clientX - rect.left) / mapScale;
            tokenOffsetY = (e.clientY - rect.top) / mapScale;
        });
    });

    window.addEventListener('mousemove', (e) => {
        if (!activeToken) return;
        const mapRect = mapContainer.getBoundingClientRect();
        let newX = (e.clientX - mapRect.left) / mapScale - tokenOffsetX;
        let newY = (e.clientY - mapRect.top) / mapScale - tokenOffsetY;
        

        activeToken.style.transition = "none";
        activeToken.style.left = `${newX}px`;
        activeToken.style.top = `${newY}px`;
    });

    window.addEventListener('mouseup', () => {
        if (!activeToken) return;

        let currentX = parseFloat(activeToken.style.left);
        let currentY = parseFloat(activeToken.style.top);
        let snappedX = Math.round(currentX / 50) * 50;
        let snappedY = Math.round(currentY / 50) * 50;


        activeToken.style.transition = "left 0.1s ease-out, top 0.1s ease-out";
        activeToken.style.left = `${snappedX}px`;
        activeToken.style.top = `${snappedY}px`;
        activeToken.classList.remove('dragging');

        const tokenId = parseInt(activeToken.getAttribute('data-token-id'));
        connection.invoke("UpdateTokenPosition", gameId, tokenId, snappedX, snappedY)
            .catch(err => console.error("Błąd zapisu ruchu: ", err));

        const currentToken = activeToken;
        setTimeout(() => {
            currentToken.style.transition = "transform 0.1s, box-shadow 0.1s";
        }, 100);

        activeToken = null;
    });

    const sidebar = document.getElementById('right-sidebar');
    const toggleBtn = document.getElementById('toggle-sidebar-btn');
    const toggleIcon = toggleBtn.querySelector('i');

    toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        if (sidebar.classList.contains('open')) toggleIcon.classList.replace('bi-chat-left-dots', 'bi-chevron-right');
        else toggleIcon.classList.replace('bi-chevron-right', 'bi-chat-left-dots');
    });

    function switchTab(tabName) {
        document.querySelectorAll('.sidebar-tabs button').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.sidebar-content').forEach(c => c.classList.remove('active'));
        document.getElementById('tab-' + tabName).classList.add('active');
        document.getElementById('content-' + tabName).classList.add('active');
    }

    const connection = new signalR.HubConnectionBuilder().withUrl("/gameHub").build();

    connection.on("UserStatusChanged", (userId, isOnline, username) => {
        const avatar = document.getElementById("player-" + userId);
        if (avatar) {
            if (isOnline) avatar.classList.add("online");
            else avatar.classList.remove("online");
        }
    });

    connection.on("RequestStatusSync", () => {
        connection.invoke("ReportStatus", gameId, currentUserId).catch(err => console.error(err));
    });

    connection.on("TokenMoved", (tokenId, x, y) => {

        if (activeToken && activeToken.getAttribute('data-token-id') == tokenId) return;

        const token = document.getElementById(`token-${tokenId}`);
        if (token) {

            token.style.transition = "left 0.2s ease-out, top 0.2s ease-out";
            token.style.left = `${x}px`;
            token.style.top = `${y}px`;
            
            setTimeout(() => {
                token.style.transition = "transform 0.1s, box-shadow 0.1s";
            }, 200);
        }
    });

    const chatInput = document.querySelector('#content-chat input');
    const sendBtn = document.querySelector('#content-chat button');
    const chatBox = document.querySelector('.chat-messages');
    chatBox.scrollTop = chatBox.scrollHeight;

    connection.on("ReceiveGameMessage", (username, message, time) => {
        const isMe = username === myUsername;
        const isDice = message.StartsWith ? message.startsWith("[DICE]") : message.indexOf("[DICE]") === 0;
        const cleanText = isDice ? message.replace("[DICE]", "") : message;

        const msgWrapper = document.createElement('div');
        msgWrapper.className = "d-flex w-100 mb-2";

        if (isDice) {

            msgWrapper.style.justifyContent = "center";
            msgWrapper.innerHTML = `
                <div class="w-100 border border-warning text-center p-2 rounded-3 bg-dark text-warning" style="max-width: 90%; font-size: 0.9rem; box-shadow: 0 0 10px rgba(255,193,7,0.3); animation: pulse 1s ease-out;">
                    <div class="text-muted" style="font-size: 0.65rem;">${time} - ${isMe ? "You" : username} rolled:</div>
                    <div class="fw-bold">${cleanText}</div>
                </div>
            `;
        } else {

            msgWrapper.style.justifyContent = isMe ? "flex-end" : "flex-start";
            const msgBubble = document.createElement('div');
            msgBubble.style.maxWidth = "80%"; msgBubble.style.padding = "8px 12px"; msgBubble.style.borderRadius = "10px"; msgBubble.style.wordWrap = "break-word";
            if (isMe) {
                msgBubble.style.backgroundColor = "#0d6efd"; msgBubble.style.color = "white";
                msgBubble.innerHTML = `<div class="d-flex justify-content-between align-items-baseline mb-1"><strong class="small me-3">Me</strong> <span class="text-light opacity-75" style="font-size: 0.65rem;">${time}</span></div><div>${cleanText}</div>`;
            } else {
                msgBubble.style.backgroundColor = "#333333"; msgBubble.style.color = "white";
                msgBubble.innerHTML = `<div class="d-flex justify-content-between align-items-baseline mb-1"><strong class="text-warning small me-3">${username}</strong> <span class="text-muted" style="font-size: 0.65rem;">${time}</span></div><div>${cleanText}</div>`;
            }
            msgWrapper.appendChild(msgBubble);
        }

        chatBox.appendChild(msgWrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
    });

    function sendMessage() {
        if (chatInput.value.trim() !== "") {
            connection.invoke("SendMessageToGame", gameId, myUsername, chatInput.value).catch(err => console.error(err));
            chatInput.value = "";
        }
    }
    sendBtn.addEventListener("click", sendMessage);
    chatInput.addEventListener("keypress", (e) => { if (e.key === 'Enter') sendMessage(); });

    connection.start().then(() => {
        connection.invoke("JoinGameSession", gameId, myUsername);
        const myAvatar = document.getElementById("player-" + currentUserId);
        if (myAvatar) myAvatar.classList.add("online");
    }).catch(err => console.error(err));

    document.getElementById("exit-vtt").addEventListener("click", () => {
        connection.invoke("LeaveGameSession", gameId);
    });


    
    function setMapBackground(url) {
        let newWidth = 5000;
        let newHeight = 5000;

        const applyBackgroundAndRescueTokens = () => {
            mapContainer.style.width = newWidth + 'px';
            mapContainer.style.height = newHeight + 'px';

            mapX = (window.innerWidth - (newWidth * mapScale)) / 2;
            mapY = (window.innerHeight - (newHeight * mapScale)) / 2;
            updateMapTransform();

            if (url) {
                mapContainer.style.backgroundImage = `
                    linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
                    url('${url}')
                `;
                mapContainer.style.backgroundSize = '50px 50px, 50px 50px, 100% 100%';
                mapContainer.style.backgroundRepeat = 'repeat, repeat, no-repeat';
                mapContainer.style.backgroundColor = '#111'; 
            } else {
                mapContainer.style.backgroundImage = `
                    linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px)
                `;
                mapContainer.style.backgroundSize = '50px 50px';
                mapContainer.style.backgroundColor = '#2b2b2b';
            }


            document.querySelectorAll('.game-token').forEach(token => {
                let currentX = parseFloat(token.style.left);
                let currentY = parseFloat(token.style.top);
                let needsRescue = false;

                if (currentX >= newWidth - 100) { currentX = Math.max(0, newWidth - 100); needsRescue = true; }
                if (currentY >= newHeight - 100) { currentY = Math.max(0, newHeight - 100); needsRescue = true; }

                if (needsRescue) {
                    currentX = Math.round(currentX / 50) * 50;
                    currentY = Math.round(currentY / 50) * 50;

                    token.style.transition = "left 0.4s ease-out, top 0.4s ease-out";
                    token.style.left = currentX + 'px';
                    token.style.top = currentY + 'px';

                    if (isDM) {
                        const tokenId = parseInt(token.getAttribute('data-token-id'));
                        connection.invoke("UpdateTokenPosition", gameId, tokenId, currentX, currentY)
                            .catch(err => console.error("Błąd ratowania pionka: ", err));
                    }
                    

                    setTimeout(() => {
                        token.style.transition = "transform 0.1s, box-shadow 0.1s";
                    }, 410);
                }
            });
        };

        if (url) {
            const img = new Image();
            img.onload = function() {
                newWidth = img.width;
                newHeight = img.height;
                applyBackgroundAndRescueTokens();
            };
            img.src = url;
        } else {
            applyBackgroundAndRescueTokens();
        }
    }

    const initialMapUrl = "@Model.MapImageUrl";
    setMapBackground(initialMapUrl);

    const changeMapBtn = document.getElementById('btn-change-map');
    if (changeMapBtn) {
        changeMapBtn.addEventListener('click', () => {
            const mapModal = new bootstrap.Modal(document.getElementById('mapGalleryModal'));
            mapModal.show();
        });
    }

    document.querySelectorAll('.map-option').forEach(option => {
        option.addEventListener('click', function() {
            const url = this.getAttribute('data-url');
            connection.invoke("ChangeMap", gameId, url).catch(err => console.error(err));
            
            const modalInstance = bootstrap.Modal.getInstance(document.getElementById('mapGalleryModal'));
            if (modalInstance) modalInstance.hide();
        });
    });

    connection.on("MapChanged", (mapUrl) => {
        setMapBackground(mapUrl);
        
        const systemMsg = mapUrl ? "The Dungeon Master has changed the battlemap!" : "The battlemap has been cleared.";
        const msgWrapper = document.createElement('div');
        msgWrapper.className = "d-flex w-100 mb-2 justify-content-center text-center";
        msgWrapper.innerHTML = `<span class="badge bg-secondary text-light w-100 p-2 opacity-75">${systemMsg}</span>`;
        chatBox.appendChild(msgWrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
    });

    document.querySelectorAll('.dice-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const sides = parseInt(this.getAttribute('data-sides'));
            

            const result = Math.floor(Math.random() * sides) + 1;
            

            let diceText = `[DICE] 🎲 D${sides} result: ${result}`;
            

            if (sides === 20) {
                if (result === 20) diceText += "(CRITICAL SUCCESS!)";
                else if (result === 1) diceText += "(CRITICAL FAILURE!)";
            }

            connection.invoke("SendMessageToGame", gameId, myUsername, diceText)
                .catch(err => console.error("Błąd rzutu kością: ", err));
        });
    });
</script>
</body>
</html>